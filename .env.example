# Public site URL, used for canonical, Open Graph, sitemap and robots.txt
PUBLIC_SITE_URL=https://revelationresource.org

# One Voice 27 updates signup endpoint (POST JSON). Empty = mock success.
PUBLIC_SUBSCRIBE_URL=
# Folder the kit ZIPs are served from: <url>/presentations.zip, images.zip, videos.zip,
# promo.zip, print.zip. Empty = download buttons show "Available soon".
PUBLIC_KIT_URL=
# Cloudflare Turnstile site key. Empty = Cloudflare test key (always passes).
PUBLIC_TURNSTILE_SITE_KEY=
# Google Analytics 4 measurement ID (G-XXXXXXX). Empty = no GA, no cookie banner.
PUBLIC_GA4_ID=
# Demo = Daniel 2. A Google Slides link opens the deck (until the ZIP is ready);
# any other URL is downloaded as a file. Empty: the button shows "Available soon".
PUBLIC_DEMO_URL=
# YouTube video ID of the trailer (the part after watch?v=). Empty = placeholder in the modal.
PUBLIC_TRAILER_YOUTUBE_ID=
PUBLIC_CONTACT_EMAIL=hello@revelationresource.org
PUBLIC_TRANSLATE_EMAIL=ministerialassociation@gc.adventist.org
# "Didn't get the email?" help link
PUBLIC_SUPPORT_EMAIL=support@revelationresource.org
# Dashed "placeholder" labels that mark where real images and sample content go.
# Handy while designing (true); keep false for anything clients or visitors see.
PUBLIC_SHOW_PLACEHOLDER_TAGS=false
# Client preview (e.g. a pages.dev link): noindex on every page, robots.txt blocks crawling,
# Keep false on the real domain.
PUBLIC_PREVIEW=false
