---
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/600.css';
import '../styles/global.css';

import displayFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import displayItalicFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url';
import bodyFont from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url';
import v2DisplayFont from '@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url';
import v2BodyFont from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import v3DisplayFont from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';

import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import BackToTop from '../components/BackToTop.astro';
import { useT, getLang, locales, localeCodes, switchPath, defaultLocale, localePath } from '../i18n';
import { baseGraph, homeGraph } from '../lib/schema';
import { config } from '../config';
import { slot, logo } from '../lib/slots';
import { getTheme, themeClass } from '../lib/theme';

const site = useT(Astro);
const lang = getLang(Astro);

interface Props {
  title?: string;
  description?: string;
  /** true on the landing page: header links are in-page anchors */
  home?: boolean;
  noindex?: boolean;
  /** second breadcrumb level (legal pages) */
  breadcrumb?: string;
}

const theme = getTheme(Astro);
const preloads = theme === 'v3' ? [v3DisplayFont, v2BodyFont, v2DisplayFont] : theme === 'v2' ? [v2DisplayFont, v2BodyFont] : [displayFont, displayItalicFont, bodyFont];

const { title, description = site.meta.description, home = false, noindex = false, breadcrumb } = Astro.props;
const pageTitle = title ? `${title} | ${site.meta.title}` : home ? site.meta.homeTitle : site.meta.title;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site).href;
const alternates = localeCodes.map((code) => ({
  hreflang: locales[code].locale.htmlLang,
  href: new URL(switchPath(Astro.url.pathname, lang, code), Astro.site).href,
}));
const xDefault = new URL(switchPath(Astro.url.pathname, lang, defaultLocale), Astro.site).href;

const ogSrc = slot('og');
const ogImage = ogSrc
  ? new URL((await getImage({ src: ogSrc, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site).href
  : new URL(lang === defaultLocale ? '/og-default.jpg' : `/og-default-${lang}.jpg`, Astro.site).href;

const ctx = {
  site,
  siteUrl: new URL('/', Astro.site).href,
  pageUrl: canonical,
  homeUrl: new URL(localePath(lang, '/'), Astro.site).href,
  lang: site.locale.htmlLang,
  logoUrl: new URL(logo?.url ?? '/apple-touch-icon.png', Astro.site).href,
  contactEmail: config.contactEmail,
  langs: localeCodes.map((c) => locales[c].locale.htmlLang),
};
const jsonLd = noindex && !breadcrumb ? null : {
  '@context': 'https://schema.org',
  '@graph': [
    ...baseGraph(ctx, { name: pageTitle, description, home, breadcrumb }),
    ...(home ? homeGraph(ctx, ogImage) : []),
  ],
};
---
<!doctype html>
<html lang={site.locale.htmlLang} class={themeClass(theme)}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  {!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}
  <meta name="theme-color" content={theme === 'v1' ? '#0A0806' : theme === 'v3' ? '#F5F3EE' : '#FFFFFF'} />
  <meta name="color-scheme" content={theme === 'v1' ? 'dark' : 'light'} />
  <!-- tab icon: church symbol on a tile in each design option's colours; ICO/PNG for older browsers -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href={theme === 'v3' ? '/favicon-v3.svg' : theme === 'v2' ? '/favicon-v2.svg' : '/favicon.svg'} type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content={site.locale.ogLocale} />
  {localeCodes.filter((c) => c !== lang).map((c) => <meta property="og:locale:alternate" content={locales[c].locale.ogLocale} />)}
  <meta property="og:site_name" content={site.meta.title} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:alt" content={site.meta.ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {preloads.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <!-- JS flag for reveal animations + Google Consent Mode v2 defaults (denied) -->
  <script is:inline define:vars={{ gaId: config.ga4Id }}>
    document.documentElement.classList.add('js');
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    if (gaId) {
      gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
        analytics_storage: 'denied', wait_for_update: 500,
      });
    }
  </script>
</head>
<body id="top">
  <a class="skip" href="#main">{site.skipLink}</a>
  <Header home={home} />
  <MobileMenu home={home} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer home={home} />
  <BackToTop />
  {config.ga4Id && <ConsentBanner />}

  <script>
    import { track } from '../scripts/analytics';

    // Declarative events: <a data-track="cta_click" data-track-location="hero">
    document.addEventListener('click', (e) => {
      const el = (e.target as Element).closest<HTMLElement>('[data-track]');
      if (!el) return;
      const params: Record<string, string> = {};
      if (el.dataset.trackLocation) params.location = el.dataset.trackLocation;
      track(el.dataset.track!, params);
    });

    // Scroll reveal
    const els = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('in'));
    }
  </script>
</body>
</html>
