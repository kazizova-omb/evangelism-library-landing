---
// /download?t=<token> (and /es/download): opened from the link in the email.
// The page is static; the file list comes from /api/download for the token.
import { langPaths, useT, getLang, localePath } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { config } from '../../config';
import { rich, fill } from '../../lib/rich';

export const getStaticPaths = langPaths;

const site = useT(Astro);
const lang = getLang(Astro);
const d = site.download;
const support = `<a href="mailto:${config.supportEmail}">${config.supportEmail}</a>`;
---
<Base title={d.title} noindex>
  <section class="section dl glow-r" data-lang={lang}>
    <div class="wrap dl__in">
      <p class="eyebrow">{d.eyebrow}</p>
      <h1 class="h2" set:html={rich(d.heading)} />

      <p class="dl__status" id="dlLoading" role="status">{d.loading}</p>

      <div id="dlReady" hidden>
        <p class="sub"><span id="dlGreeting" data-template={d.greeting}></span> {d.text}</p>
        <p class="dl__test" id="dlTest" hidden>{d.testNote}</p>
        <h2 class="dl__title">{d.filesTitle}</h2>
        <ul class="dl__files" id="dlFiles" data-label={d.downloadLabel}></ul>
      </div>

      <div id="dlInvalid" hidden>
        <h2 class="dl__title">{d.invalidTitle}</h2>
        <p class="sub">{d.invalidText}</p>
        <a href={`${localePath(lang, '/')}#get`} class="btn btn--gold dl__cta">{d.invalidCta}</a>
      </div>

      <p class="dl__help" set:html={fill(d.help, { support })} />
    </div>
  </section>
</Base>

<style>
  .dl { min-height: 80vh; padding-top: calc(76px + clamp(48px, 6vw, 96px)) }
  .dl__in { max-width: 820px }
  .dl .sub { margin-top: 8px; max-width: 640px }
  .dl__status { margin-top: 24px; color: var(--muted-solid) }
  .dl__test { margin-top: 16px; padding: 10px 14px; border-radius: 8px; border: 1px dashed var(--line); font-size: 14px; color: var(--muted-solid) }
  .dl__title { margin: 40px 0 16px; font-size: 13px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--gold) }
  .dl__files { list-style: none; border-top: 1px solid var(--line) }
  .dl__files :global(li) { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 18px 0; border-bottom: 1px solid var(--line) }
  .dl__files :global(b) { display: block; font-weight: 600; color: var(--ink) }
  .dl__files :global(small) { display: block; margin-top: 2px; font-size: 13px; color: var(--muted-solid) }
  .dl__files :global(.btn) { flex: none }
  .dl__cta { margin-top: 28px }
  .dl__help { margin-top: 48px; font-size: 14px; color: var(--muted-solid) }
  .dl__help :global(a) { color: var(--gold-hi); text-decoration: underline; text-underline-offset: 3px }
  @media (max-width: 760px) {
    .dl__files :global(li) { flex-direction: column; align-items: stretch; gap: 12px }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.dl')!;
  const t = new URLSearchParams(location.search).get('t');
  const show = (id: string) => {
    ['dlLoading', 'dlReady', 'dlInvalid'].forEach((x) => (document.getElementById(x)!.hidden = x !== id));
  };

  async function load() {
    if (!t) return show('dlInvalid');
    try {
      const res = await fetch(`/api/download?t=${encodeURIComponent(t)}&lang=${root.dataset.lang}`);
      const data = await res.json();
      if (!res.ok || !data.ok) return show('dlInvalid');

      const greeting = document.getElementById('dlGreeting')!;
      greeting.textContent = data.name ? (greeting.dataset.template ?? '').replace('{name}', data.name) : '';
      document.getElementById('dlTest')!.hidden = !data.test;

      const list = document.getElementById('dlFiles')!;
      list.replaceChildren(...data.files.map((f: { label: string; size: string; url: string }) => {
        const li = document.createElement('li');
        const info = document.createElement('div');
        const b = document.createElement('b'); b.textContent = f.label;
        const s = document.createElement('small'); s.textContent = f.size;
        info.append(b, s);
        const a = document.createElement('a');
        a.className = 'btn btn--gold btn--sm'; a.href = f.url; a.textContent = list.dataset.label ?? 'Download';
        li.append(info, a);
        return li;
      }));
      show('dlReady');
    } catch {
      show('dlInvalid');
    }
  }
  load();
</script>
