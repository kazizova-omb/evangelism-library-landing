---
import Base from '../layouts/Base.astro';
import { useT } from '../i18n';
import { rich } from '../lib/rich';

const site = useT(Astro);

const n = site.notFound;
---
<Base title={n.title} noindex>
  <section class="section notfound glow-l">
    <div class="section-head">
      <p class="eyebrow">{n.eyebrow}</p>
      <h1 class="h2" set:html={rich(n.heading)} />
      <p class="sub">{n.text}</p>
      <a href="/" class="btn btn--gold">{n.cta}</a>
    </div>
  </section>
</Base>

<style>
  .notfound { min-height: 80vh; min-height: 80svh; display: grid; place-items: center; padding-top: 140px }
  .notfound .sub { margin-bottom: 32px }
</style>
