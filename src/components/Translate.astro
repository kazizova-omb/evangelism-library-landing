---
import { site } from '../content/site';
import { config } from '../config';
import { rich } from '../lib/rich';

const t = site.translate;
const mailto = `mailto:${config.translateEmail}?subject=${encodeURIComponent(t.mailSubject)}`;
---
<section class="section" id="translate" aria-labelledby="translate-title">
  <div class="translate reveal">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 class="h2" id="translate-title" set:html={rich(t.title)} />
    <ul class="langs" role="list">
      {t.available.map((l) => <li class="lang" lang={l.lang}>{l.name}<span class="visually-hidden" lang="en">, {t.legendAvailable.toLowerCase()}</span></li>)}
      {t.inProgress.map((l) => <li class="lang lang--soon" lang={l.lang}>{l.name}<span class="visually-hidden" lang="en">, {t.legendInProgress.toLowerCase()}</span></li>)}
    </ul>
    <div class="legend" aria-hidden="true"><span>{t.legendAvailable}</span><span>{t.legendInProgress}</span></div>
    <p class="sub">{t.sub}</p>
    <a href={mailto} class="btn btn--ghost" data-track="translate_click">{t.cta}</a>
    {config.showPlaceholderTags && <p class="form-note sample"><span class="tag">{site.placeholderTags.languages}</span></p>}
  </div>
</section>

<style>
  .translate { max-width: 880px; margin: 0 auto; text-align: center }
  .langs { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 36px 0 14px }
  .lang { padding: 10px 18px; border-radius: 999px; border: 1px solid rgba(227, 178, 94, .4); font-size: 15px; color: var(--ink) }
  .lang--soon { border-style: dashed; border-color: rgba(243, 235, 221, .18); color: var(--muted-solid) }
  .legend { display: flex; justify-content: center; gap: 22px; font-size: 13px; color: var(--muted-solid); margin-bottom: 40px }
  .legend span::before { content: ""; display: inline-block; width: 10px; height: 10px; border-radius: 50%; border: 1px solid rgba(227, 178, 94, .6); margin-right: 8px; vertical-align: -1px }
  .legend span + span::before { border-style: dashed; border-color: rgba(243, 235, 221, .3) }
  .translate .sub { margin-bottom: 28px }
  .sample { margin-top: 22px }
</style>
