---
import { useT } from '../i18n';

const site = useT(Astro);
---
<!-- Appears once the first screen is scrolled past; a sentinel keeps it free of scroll listeners -->
<div class="to-top-sentinel" id="toTopSentinel" aria-hidden="true"></div>
<button class="to-top" id="toTop" type="button" aria-label={site.backToTop} title={site.backToTop} hidden>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5.5 11.5L12 5l6.5 6.5"/></svg>
</button>

<style>
  .to-top-sentinel { position: absolute; top: 0; left: 0; width: 1px; height: 120vh; pointer-events: none }
  .to-top { position: fixed; right: max(20px, env(safe-area-inset-right)); bottom: max(20px, env(safe-area-inset-bottom)); z-index: 55; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center;
    color: var(--gold-hi); background: rgba(20, 16, 12, .82); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 0 0 1px rgba(227, 178, 94, .35) inset, 0 14px 34px -12px rgba(0, 0, 0, .9);
    opacity: 0; transform: translateY(12px); transition: opacity .3s var(--ease), transform .3s var(--ease), box-shadow .2s }
  .to-top.is-visible { opacity: 1; transform: none }
  .to-top:hover { box-shadow: 0 0 0 1px var(--gold) inset, 0 14px 34px -12px rgba(0, 0, 0, .9); transform: translateY(-2px) }
  .to-top svg { width: 20px; height: 20px }
  /* phones: step aside while the full-width cookie banner is open */
  @media (max-width: 760px) {
    .to-top { width: 44px; height: 44px }
    :global(body:has(.consent-banner:not([hidden]))) .to-top { opacity: 0; pointer-events: none }
  }
</style>

<script>
  const btn = document.getElementById('toTop') as HTMLButtonElement;
  const sentinel = document.getElementById('toTopSentinel')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  btn.hidden = false;

  new IntersectionObserver(([e]) => {
    const show = !e.isIntersecting;
    btn.classList.toggle('is-visible', show);
    btn.tabIndex = show ? 0 : -1;
    btn.setAttribute('aria-hidden', String(!show));
  }).observe(sentinel);

  btn.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduced.matches ? 'auto' : 'smooth' });
    // keep keyboard users at the top too
    document.querySelector<HTMLElement>('.header .brand')?.focus({ preventScroll: true });
  });
</script>
