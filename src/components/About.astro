---
import Brush from './Brush.astro';
import Motto from './Motto.astro';
import SlotImage from './SlotImage.astro';
import { useT } from '../i18n';
import { rich } from '../lib/rich';
import { slot } from '../lib/slots';
import { getTheme } from '../lib/theme';

const site = useT(Astro);
const a = site.about;
// photo for the block: src/assets/slots/v3/about.* (any ratio; shown 4:5)
const image = slot('about', getTheme(Astro));
---
<section class="section glow-l" id="about" aria-labelledby="about-title">
  <Brush w={582} h={490} at="left:0;bottom:0" box={1585.025} x={-822} y={-273} size={1121.578} rotate={132.84} opacity={0.14} tone="teal" />
  <div class="wrap about">
    <div class="about__photo reveal">
      {image && <SlotImage src={image} alt={a.imageAlt} sizes="(max-width: 1020px) min(440px, calc(100vw - 40px)), 460px" widths={[440, 502]} />}
    </div>
    <div class="about__copy reveal">
      <p class="eyebrow">{a.eyebrow}</p>
      <h2 class="h2" id="about-title" set:html={rich(a.title)} />
      <p class="about__lead">{a.lead}</p>
      {a.paragraphs.map((p) => <p class="about__text">{p}</p>)}
      <p class="about__motto">
        <a href={site.license.url} target="_blank" rel="license noopener" class="about__badge" aria-label={site.license.label}>{site.license.badge}</a>
        <Motto />
      </p>
    </div>
  </div>
</section>

<style>
  /* photo on the left, text on the right */
  .about { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 40px 80px; align-items: center }
  .about__photo { position: relative; aspect-ratio: 4 / 5; border-radius: 8px; overflow: hidden; background: rgba(255, 255, 255, .06); box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .55) }
  .about__lead { margin-top: 4px; font-size: clamp(17px, 1.35vw, 19px); line-height: 1.65; color: var(--ink-2) }
  .about__text { margin-top: 16px; font-size: 16px; line-height: 1.7; color: var(--ink-2) }
  .about__motto { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--line); display: flex; align-items: flex-start; gap: 16px; color: var(--ink) }
  .about__badge { flex: none; padding: 5px 10px; line-height: 16px; border-radius: 4px; font-family: var(--body); font-size: 12px; font-weight: 700; letter-spacing: .1em; color: var(--bg, #fff); background: var(--ink) }
  .about__badge:hover { opacity: .85 }

  @media (max-width: 1020px) {
    .about { grid-template-columns: 1fr; gap: 32px }
    .about__photo { max-width: 440px }
  }
  @media (max-width: 760px) {
    .about__photo { aspect-ratio: 4 / 3 }
  }
</style>
