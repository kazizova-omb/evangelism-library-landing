---
// Download portal, built from the portal design mock-up (Nov 2026): Image Library (filter by book and chapter,
// curated categories, sort, pages), Materials (series banner, presentations, video, marketing, audio), Search,
// an image page, sign-in by email + 6-digit code, and "How will you use this?" with a format choice before
// every download. Browsing is open; downloading needs a session.
// Data and sessions: src/scripts/api.ts (test mode with the design's sample data until the backend is ready).
import { useT, getLang, localePath } from '../i18n';
import { config } from '../config';
import { IMAGE_FORMATS } from '../lib/portalSample';
import wordmark from '../assets/brand/all-things-new.svg?url';

const site = useT(Astro);
const lang = getLang(Astro);
const p = site.portal;
const home = localePath(lang, '/');
const testMode = !config.apiUrl;
const text = { ...p, home, register: `${home}#access`, siteKey: config.turnstileSiteKey, testMode, imageFormats: IMAGE_FORMATS, brand: site.brand };

const I = {
  search: '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/>',
  signin: '<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  back: '<path d="M19 12H5M12 19l-7-7 7-7"/>',
  book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
  caret: '<path d="M6 9l6 6 6-6"/>',
  dl: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>',
  x: '<path d="M18 6 6 18M6 6l12 12"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  screen: '<path d="M3 4h18v12H3zM8 20h8M12 16v4"/>',
  out: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
};
const svg = (d: string, attrs = '') => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" ${attrs}>${d}</svg>`;
---
<div id="shell" data-lang={lang}>
  <header class="appbar">
    <a class="brandbar" href={home} aria-label={site.brand}>
      <img src={wordmark} alt="All Things New: Hope starts here." width="166" height="30" />
      <span class="lk-div" aria-hidden="true"></span>
      <span class="lk-rmr">Revelation Media<br />Resources</span>
    </a>
    <nav class="nav" aria-label={p.title}>
      <button type="button" class="navlink" data-nav="library">{p.nav.library}</button>
      <button type="button" class="navlink" data-nav="materials">{p.nav.materials}</button>
      <button type="button" class="navlink" data-nav="search">{p.nav.search}</button>
    </nav>
    <div class="grow"></div>
    <button type="button" class="searchmini" data-go="search"><Fragment set:html={svg(I.search)} /><span>{p.searchMini}</span><kbd>/</kbd></button>
    <div class="profile-wrap">
      <button type="button" class="sign-in" data-go="login"><Fragment set:html={svg(I.signin)} />{p.signIn}</button>
      <button type="button" class="avatar" id="avatar" aria-label={p.account} aria-haspopup="menu">A</button>
    </div>
  </header>

  <main class="wrap">
    {testMode && <p class="hint" style="margin:0 0 18px">{p.testNote}</p>}

    <!-- LOGIN -->
    <section class="view" id="v-login" aria-labelledby="login-title">
      <div class="login-centre">
        <div class="auth-card">
          <div class="auth-brand"><img class="logo-auth" src={wordmark} alt="All Things New: Hope starts here." width="210" height="38" /></div>
          <form id="step-email" novalidate>
            <h1 class="auth-h" id="login-title">{p.login.title}</h1>
            <p class="auth-sub">{p.login.text}</p>
            <div class="auth-err" id="email-err" role="alert"></div>
            <div class="field" id="email-field">
              <label for="email">{p.login.email}</label>
              <input class="input" id="email" type="email" placeholder={p.login.emailPlaceholder} autocomplete="email" inputmode="email" required />
              <p class="ferr">{p.login.emailError}</p>
              <p class="suggest" id="email-suggest" hidden></p>
            </div>
            <div class="ts-box" id="ts-box"></div>
            <button type="submit" class="btn btn-primary" id="send-code"><span>{p.login.continue}</span><Fragment set:html={svg(I.arrow, 'width="17" height="17"')} /></button>
            <p class="msg">{p.login.notYet} <a href={text.register}>{p.login.register}</a> · <a href="#library">{p.login.keepBrowsing}</a></p>
          </form>
          <form id="step-code" novalidate hidden>
            <button type="button" class="backlink" id="back-to-email"><Fragment set:html={svg(I.back)} />{p.login.back}</button>
            <h1 class="auth-h">{p.login.codeTitle}</h1>
            <p class="auth-sub" id="code-text"></p>
            <div class="auth-err" id="code-err" role="alert"></div>
            <div class="otp" id="otp" role="group" aria-label={p.login.codeTitle}>
              {[0, 1, 2, 3, 4, 5].map((i) => <input maxlength="1" inputmode="numeric" autocomplete={i === 0 ? 'one-time-code' : 'off'} aria-label={`${i + 1}`} />)}
            </div>
            <button type="submit" class="btn btn-primary" id="verify" style="margin-top:16px">{p.login.verify}</button>
            {testMode && <p class="hint">{p.testNote}</p>}
            <p class="msg">{p.login.resendQ} <a href="#" id="resend">{p.login.resend}</a></p>
          </form>
        </div>
      </div>
    </section>

    <!-- IMAGE LIBRARY -->
    <section class="view" id="v-library" aria-labelledby="library-title">
      <div class="page-head">
        <div><h1 class="page-title" id="library-title">{p.library.title}</h1><p class="page-sub" id="library-count">&nbsp;</p></div>
        <div class="grow"></div>
        <div class="filter-wrap">
          <button type="button" class="filter-btn" id="filter-btn" aria-haspopup="dialog">
            <Fragment set:html={svg(I.book, 'class="fi"')} />
            <span id="filter-btn-label">{p.library.filter}</span>
            <Fragment set:html={svg(I.caret, 'class="car"')} />
          </button>
        </div>
        <select class="select" id="sort" aria-label="Sort">
          <option value="new">{p.library.sortNew}</option>
          <option value="views">{p.library.sortViews}</option>
          <option value="downloads">{p.library.sortDownloads}</option>
          <option value="az">{p.library.sortAz}</option>
        </select>
      </div>
      <div class="cat-rail-wrap">
        <div class="cat-rail-lbl">{p.library.popular}</div>
        <div class="cat-rail" id="cat-rail"></div>
      </div>
      <div class="active-chips" id="active-chips"></div>
      <div class="grid" id="library-grid" aria-live="polite"></div>
      <nav class="pagination" id="pagination" aria-label="Pages"></nav>
      <p class="pg-info" id="pg-info"></p>
    </section>

    <!-- MATERIALS -->
    <section class="view" id="v-materials" aria-labelledby="materials-title">
      <div class="series-banner">
        <div class="sb-grid">
          <div class="sb-left">
            <div class="sb-eyebrow">{p.materials.eyebrow}</div>
            <h1 class="sb-title" id="materials-title" set:html={p.materials.title.replace(/\*(.+?)\*/g, '<b>$1</b>')} />
            <p class="sb-text">{p.materials.text}</p>
            <div class="sb-stats" id="sb-stats"></div>
          </div>
          <div class="sb-right">
            <div class="sb-langs"><div class="ll">{p.materials.language}</div><div class="lang-pills" id="lang-pills"></div></div>
            <div class="sb-dlrow">
              <div class="sb-size"><Fragment set:html={svg(I.dl)} /><span id="series-size"></span></div>
              <button type="button" class="btn-series" id="dl-series"><Fragment set:html={svg(I.dl)} />{p.materials.downloadSeries}</button>
            </div>
          </div>
        </div>
      </div>
      <div class="mat-tabs" id="mat-tabs" role="tablist"></div>
      <div id="mat-content"></div>
    </section>

    <!-- SEARCH -->
    <section class="view" id="v-search" aria-labelledby="search-title">
      <div class="search-hero">
        <h1 id="search-title">{p.search.title}</h1>
        <p>{p.search.text}</p>
        <div class="searchbig" id="searchbig">
          <Fragment set:html={svg(I.search)} />
          <input id="search-input" type="search" placeholder={p.search.placeholder} autocomplete="off" aria-label={p.search.title} />
          <button type="button" class="clr" id="search-clr" aria-label={p.search.clear}><Fragment set:html={svg(I.x, 'width="15" height="15"')} /></button>
        </div>
        <div class="search-sug" id="search-sug"><div class="lbl">{p.search.popular}</div><div class="row" id="sug-row"></div></div>
      </div>
      <div id="search-results" aria-live="polite"></div>
    </section>

    <!-- IMAGE PAGE -->
    <section class="view" id="v-image">
      <div class="det-top">
        <a class="backbtn" href="#library" title={p.detail.back} aria-label={p.detail.back}><Fragment set:html={svg(I.back, 'width="18" height="18"')} /></a>
        <div class="page-sub" style="margin:0">{p.detail.crumb} / <span id="det-crumb"></span></div>
      </div>
      <div class="layout" id="detail-body"></div>
    </section>
  </main>
</div>

<!-- popovers -->
<div class="pop-overlay" id="filter-overlay"></div>
<div class="filter-panel" id="filter-panel" role="dialog" aria-label={p.library.browseBy}></div>
<div class="pop-overlay" id="profile-overlay"></div>
<div class="profile-menu" id="profile-menu" role="menu">
  <div class="pm-head"><div class="pm-av" id="pm-av">A</div><div class="pm-info"><b id="pm-email"></b><span>{p.signedIn}</span></div></div>
  <div class="pm-div"></div>
  <a class="pm-item" href="#library" role="menuitem"><Fragment set:html={svg(I.grid)} />{p.nav.library}</a>
  <a class="pm-item" href="#materials" role="menuitem"><Fragment set:html={svg(I.screen)} />{p.nav.materials}</a>
  <div class="pm-div"></div>
  <button type="button" class="pm-item danger" id="sign-out" role="menuitem"><Fragment set:html={svg(I.out)} />{p.signOut}</button>
</div>

<!-- download: purpose and format, progress, done -->
<div class="modal" id="dl-modal" role="dialog" aria-modal="true" aria-labelledby="dl-title">
  <div class="sheet">
    <div class="sheet-head"><img class="sheet-thumb" id="dl-thumb" alt="" /><div><div class="st-t" id="dl-title"></div><div class="st-s" id="dl-sub"></div></div>
      <button type="button" class="x" id="dl-close" aria-label={p.dl.close}><Fragment set:html={svg(I.x, 'width="18" height="18"')} /></button></div>
    <form id="dl-form" novalidate>
      <div class="sheet-body">
        <div class="sheet-q">{p.dl.title}</div>
        <div class="sheet-qs">{p.dl.text}</div>
        <div class="purpose" id="purpose-list" role="radiogroup" aria-label={p.dl.title}></div>
        <div class="other-wrap" id="other-wrap"><textarea id="other-text" placeholder={p.dl.otherPlaceholder} aria-label={p.dl.otherPlaceholder}></textarea></div>
        <div class="fmt" id="fmt-list" role="radiogroup" aria-label={p.dl.rFormat}></div>
        <div class="warn" id="dl-warn" role="alert"></div>
      </div>
      <div class="sheet-foot">
        <button type="submit" class="btn btn-primary"><Fragment set:html={svg(I.dl, 'width="16" height="16"')} /><span id="dl-cta"></span></button>
        <button type="button" class="btn btn-ghost" id="dl-cancel">{p.dl.cancel}</button>
      </div>
    </form>
    <div id="dl-progress" hidden>
      <div class="dl-stage"><div class="dl-ic"><Fragment set:html={svg(I.dl)} /></div>
        <div class="dl-h">{p.dl.preparing}</div><div class="dl-p">{p.dl.packaging}</div>
        <div class="bar"><div class="fill" id="dl-fill"></div></div><div class="bar-pct" id="dl-pct">0%</div></div>
    </div>
    <div id="dl-done" hidden>
      <div class="dl-stage"><div class="dl-ic ok"><Fragment set:html={svg(I.check)} /></div>
        <div class="dl-h">{p.dl.started}</div><div class="dl-p" id="dl-done-text"></div>
        <div class="receipt" id="dl-receipt"></div></div>
      <div class="sheet-foot"><button type="button" class="btn btn-primary" id="dl-done-btn">{p.dl.done}</button></div>
    </div>
  </div>
</div>

<div class="lightbox" id="lb" role="dialog" aria-label={p.detail.zoom}><button type="button" class="close" aria-label={p.detail.close}><Fragment set:html={svg(I.x, 'width="20" height="20"')} /></button><img id="lb-img" alt="" /></div>
<div class="toast" id="toast" role="status"><Fragment set:html={svg(I.check)} /><span id="toast-msg"></span></div>

<script type="application/json" id="portal-text" set:html={JSON.stringify(text)} />

<style is:global>
  /* buttons replace the design's clickable divs: start them from a clean slate */
  button{font:inherit;color:inherit;background:none;border:0;padding:0;margin:0;cursor:pointer;text-align:inherit}
  :root{
    color-scheme: light;
    --bg:#f5f3ee; --bg-2:#ece9e1; --panel:#ffffff; --panel-2:#faf8f2; --panel-3:#f1eee7;
    --ink:#1f2160; --ink-2:#3a3c6e; --muted:#5e607f; --faint:#9b98a9;
    --line:rgba(31,33,96,.12); --line-2:rgba(31,33,96,.2);
    --indigo:#2a2c7c; --indigo-d:#1f2160; --indigo-soft:rgba(42,44,124,.09);
    --cyan:#7fe0ec; --teal:#36b1be; --teal-text:#0a7383; --teal-soft:rgba(54,177,190,.13);
    --pink:#d98bb8; --pink-soft:rgba(217,139,184,.15); --coral:#f29a7c;
    --accent:#2a2c7c; --accent-2:#0a7383; --accent-soft:rgba(54,177,190,.13);
    --serif:'DM Serif Display',Georgia,serif; --sans:'Inter',system-ui,sans-serif; --mono:ui-monospace,'SF Mono',Menlo,Consolas,monospace;
    --radius:18px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{font-family:var(--sans);color:var(--ink);background:var(--bg);
    background-image:radial-gradient(1100px 560px at 84% -10%, rgba(127,224,236,.3), transparent 60%),radial-gradient(900px 520px at 4% 108%, rgba(217,139,184,.16), transparent 62%);
    background-attachment:fixed;-webkit-font-smoothing:antialiased;line-height:1.5;min-height:100vh}
  a{color:inherit;text-decoration:none}button{font-family:var(--sans)}
  ::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-thumb{background:var(--line-2);border-radius:8px}

  /* BRAND LOCKUP */
  .lockup{display:inline-flex;align-items:center;gap:16px}
  .lk-left{display:flex;flex-direction:column;line-height:1}
  .lk-atn{font-weight:800;font-size:26px;letter-spacing:-.01em;color:var(--indigo)}
  .lk-atn b{color:var(--teal);font-weight:800}
  .lk-hope{font-weight:600;font-style:italic;font-size:13px;color:var(--indigo);margin-top:5px}
  .lk-div{width:1px;align-self:stretch;background:var(--line-2);margin:3px 0}
  .lk-rmr{font-weight:800;font-size:15px;line-height:1.08;letter-spacing:.03em;text-transform:uppercase;color:var(--indigo)}
  .globe{width:26px;height:26px;color:var(--indigo);flex:0 0 auto}
  .brandbar{display:inline-flex;align-items:center;gap:10px;cursor:pointer}
  .brandbar .bb-txt{font-weight:800;font-size:14px;line-height:1.05;letter-spacing:.03em;text-transform:uppercase;color:var(--indigo)}

  /* APP BAR */
  .appbar{position:sticky;top:0;z-index:30;display:flex;align-items:center;gap:16px;padding:12px 22px;background:rgba(245,243,238,.82);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
  .appbar .nav{display:flex;align-items:center;gap:4px;margin-left:10px}
  .navlink{padding:8px 13px;border-radius:10px;font-size:14px;font-weight:600;color:var(--muted);cursor:pointer;transition:.2s;white-space:nowrap}
  .navlink:hover{color:var(--ink);background:rgba(31,33,96,.05)}
  .navlink.active{color:var(--indigo);background:var(--indigo-soft)}
  .appbar .grow{flex:1}
  .searchmini{display:flex;align-items:center;gap:9px;height:40px;padding:0 14px;min-width:200px;max-width:320px;flex:0 1 300px;border-radius:11px;background:var(--panel);border:1px solid var(--line-2);color:var(--muted);cursor:text;transition:.2s}
  .searchmini:hover{border-color:var(--teal)}
  .searchmini svg{width:16px;height:16px;flex:0 0 auto}.searchmini span{font-size:13.5px}
  .searchmini kbd{margin-left:auto;font-family:var(--mono);font-size:11px;color:var(--faint);border:1px solid var(--line-2);border-radius:6px;padding:2px 6px;background:var(--panel-2)}
  .avatar{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;cursor:pointer;background:linear-gradient(135deg,var(--indigo),#4446a8);color:#fff;font-weight:700;font-size:14px;border:1px solid rgba(255,255,255,.3);transition:.2s;flex:0 0 auto}
  .avatar:hover{filter:brightness(1.08)}
  .brand-logo{height:30px;width:auto;display:block;cursor:pointer;flex:0 0 auto}
  .logo-auth{height:38px;width:auto;display:block;margin:0 auto}
  .sign-in{display:inline-flex;align-items:center;gap:8px;height:38px;padding:0 15px;border-radius:11px;border:none;cursor:pointer;font-size:13.5px;font-weight:700;background:linear-gradient(180deg,#34368c,#242672);color:#fff;transition:.2s;box-shadow:0 8px 20px -12px rgba(42,44,124,.7)}
  .sign-in:hover{filter:brightness(1.08);transform:translateY(-1px)}.sign-in svg{width:15px;height:15px}
  .profile-wrap .avatar{display:none}
  body.is-authed .profile-wrap .sign-in{display:none}
  body.is-authed .profile-wrap .avatar{display:grid}
  .login-centre{display:grid;place-items:center;min-height:62vh;padding:20px 0}

  .pop-overlay{position:fixed;inset:0;z-index:55;display:none;background:transparent}
  .pop-overlay.open{display:block}
  .profile-menu{position:fixed;z-index:60;width:250px;border:1px solid var(--line-2);border-radius:14px;background:var(--panel);box-shadow:0 30px 70px -22px rgba(31,33,96,.4);padding:8px;display:none}
  .profile-menu.open{display:block;animation:pop .2s ease}
  .pm-head{display:flex;align-items:center;gap:11px;padding:10px 11px 12px}
  .pm-av{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,var(--indigo),#4446a8);color:#fff;font-weight:700;flex:0 0 auto}
  .pm-info{min-width:0}.pm-info b{display:block;font-size:13.5px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.pm-info span{font-size:11.5px;color:var(--faint)}
  .pm-div{height:1px;background:var(--line);margin:2px 4px 6px}
  .pm-item{display:flex;align-items:center;gap:11px;padding:11px;border-radius:10px;cursor:pointer;color:var(--ink);font-size:14px;font-weight:600;transition:.18s}
  .pm-item:hover{background:var(--indigo-soft)}.pm-item svg{width:16px;height:16px;color:var(--muted)}
  .pm-item.danger{color:#c0564a}.pm-item.danger:hover{background:rgba(224,120,90,.12)}.pm-item.danger svg{color:#c0564a}

  .wrap{position:relative;z-index:1;max-width:1220px;margin:0 auto;padding:26px 22px 60px}
  .view{display:none}.view.on{display:block;animation:fade .4s ease}
  @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  @keyframes pop{from{opacity:0;transform:translateY(-6px) scale(.98)}to{opacity:1;transform:none}}
  @keyframes sheet{from{transform:translateY(100%)}to{transform:none}}

  /* AUTH */
  .auth-screen{position:relative;z-index:1;min-height:100vh;display:grid;place-items:center;padding:24px}
  .auth-card{width:100%;max-width:430px;border:1px solid var(--line);border-radius:24px;background:var(--panel);padding:36px 34px 30px;box-shadow:0 40px 90px -40px rgba(31,33,96,.4)}
  .auth-brand{display:flex;justify-content:center;margin-bottom:24px}
  .auth-brand .lockup{transform:scale(.92)}
  .auth-h{font-family:var(--serif);font-size:28px;text-align:center;color:var(--ink);line-height:1.15}
  .auth-sub{text-align:center;color:var(--muted);font-size:14px;margin-top:9px;margin-bottom:26px}
  .field{margin-bottom:14px}
  .field label{display:block;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--faint);margin-bottom:8px}
  .input{width:100%;height:50px;padding:0 15px;border-radius:13px;background:var(--panel-2);border:1px solid var(--line-2);color:var(--ink);font-size:15px;font-family:var(--sans);transition:.2s;outline:none}
  .input::placeholder{color:var(--faint)}.input:focus{border-color:var(--teal);background:#fff;box-shadow:0 0 0 4px var(--teal-soft)}
  .input.err{border-color:var(--coral);box-shadow:0 0 0 4px rgba(242,154,124,.18)}
  .btn{width:100%;height:50px;border:none;border-radius:13px;cursor:pointer;font-size:15px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:9px;transition:.2s}
  .btn-primary{background:linear-gradient(180deg,#34368c,#242672);color:#fff;box-shadow:0 10px 24px -12px rgba(42,44,124,.7)}
  .btn-primary:hover{filter:brightness(1.08);transform:translateY(-1px)}.btn-primary:active{transform:none}
  .btn-ghost{background:var(--panel);border:1px solid var(--line-2);color:var(--ink)}.btn-ghost:hover{background:var(--panel-3)}
  .msg{font-size:13px;color:var(--faint);text-align:center;margin-top:16px;line-height:1.5}.msg a{color:var(--teal-text);cursor:pointer;font-weight:600}
  .hint{margin-top:18px;padding:11px 13px;border-radius:11px;background:var(--teal-soft);border:1px solid rgba(54,177,190,.3);font-size:12.5px;color:var(--teal-text);text-align:center}
  .otp{display:flex;gap:10px;justify-content:center;margin:4px 0 8px}
  .otp input{width:46px;height:56px;text-align:center;font-family:var(--mono);font-size:22px;border-radius:12px;background:var(--panel-2);border:1px solid var(--line-2);color:var(--ink);outline:none;transition:.2s}
  .otp input:focus{border-color:var(--teal);background:#fff;box-shadow:0 0 0 4px var(--teal-soft)}
  .backlink{display:inline-flex;align-items:center;gap:7px;color:var(--muted);font-size:13.5px;font-weight:600;cursor:pointer;margin-bottom:18px}
  .backlink:hover{color:var(--ink)}.backlink svg{width:15px;height:15px}
  .emailtag{color:var(--teal-text);font-weight:600}

  /* PAGE HEAD */
  .page-head{display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:20px}
  .page-title{font-family:var(--serif);font-size:34px;letter-spacing:-.01em;color:var(--ink);line-height:1.05}
  .page-sub{color:var(--muted);font-size:14px;margin-top:6px}
  .page-head .grow{flex:1}
  .select{height:42px;padding:0 12px;border-radius:11px;background:var(--panel);border:1px solid var(--line-2);color:var(--muted);font-size:13.5px;font-weight:600;cursor:pointer;font-family:var(--sans);outline:none}

  /* CATEGORY CAROUSEL */
  .cat-rail-wrap{margin-bottom:22px}
  .cat-rail-lbl{font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--faint);margin-bottom:11px}
  .cat-rail{display:flex;gap:13px;overflow-x:auto;padding-bottom:6px;scroll-snap-type:x mandatory}
  .cat-rail::-webkit-scrollbar{height:6px}
  .cat-tile{position:relative;flex:0 0 auto;width:150px;border-radius:14px;overflow:hidden;cursor:pointer;border:1px solid var(--line-2);background:var(--panel);scroll-snap-align:start;transition:.25s;box-shadow:0 10px 26px -20px rgba(31,33,96,.4)}
  .cat-tile:hover{transform:translateY(-3px);border-color:var(--teal)}
  .cat-tile.active{border-color:var(--teal);box-shadow:0 0 0 2px var(--teal),0 12px 26px -18px rgba(31,33,96,.5)}
  .cat-tile .ct-img{height:92px;overflow:hidden;background:#111}
  .cat-tile .ct-img img{width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.2,.7,.2,1)}
  .cat-tile:hover .ct-img img{transform:scale(1.07)}
  .cat-tile .ct-body{padding:10px 12px;display:flex;align-items:center;justify-content:space-between;gap:8px}
  .cat-tile .ct-name{font-weight:700;font-size:13.5px;color:var(--ink)}
  .cat-tile .ct-cnt{font-family:var(--mono);font-size:11px;color:#fff;background:var(--teal);border-radius:20px;padding:1px 7px;font-weight:600}
  .cat-tile.active .ct-name{color:var(--teal-text)}
  .cat-tile .ct-soon{font-family:var(--sans);font-size:10px;font-weight:600;color:var(--faint);background:var(--panel-3);border:1px solid var(--line);border-radius:20px;padding:2px 8px}

  .active-chips{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px}
  .fchip{display:inline-flex;align-items:center;gap:10px;padding:8px 8px 8px 14px;border-radius:999px;background:var(--teal-soft);border:1px solid rgba(54,177,190,.4);color:var(--teal-text);font-size:14px;font-weight:600}
  .fchip .body{display:inline-flex;align-items:center;gap:9px;cursor:pointer}.fchip .fi{width:14px;height:14px}
  .fchip .sub{color:#4a8c97;font-weight:500;font-size:12.5px;font-family:var(--mono)}
  .fchip .xx{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;cursor:pointer;background:rgba(54,177,190,.22);transition:.18s;color:var(--teal-text)}
  .fchip .xx:hover{background:var(--teal);color:#fff}.fchip .xx svg{width:12px;height:12px}

  /* FILTER */
  .filter-wrap{position:relative}
  .filter-btn{display:inline-flex;align-items:center;gap:10px;height:42px;padding:0 16px;border-radius:11px;border:1px solid var(--line-2);background:var(--panel);color:var(--ink);font-size:14px;font-weight:600;cursor:pointer;transition:.2s}
  .filter-btn:hover{background:var(--panel-3)}
  .filter-btn.active{background:var(--teal-soft);border-color:rgba(54,177,190,.45);color:var(--teal-text)}
  .filter-btn .fi{width:17px;height:17px}.filter-btn .car{width:14px;height:14px;opacity:.6;transition:transform .2s}.filter-btn.open .car{transform:rotate(180deg)}
  .filter-panel{position:fixed;z-index:60;width:320px;max-height:72vh;overflow:auto;border:1px solid var(--line-2);border-radius:16px;background:var(--panel);box-shadow:0 30px 70px -22px rgba(31,33,96,.42);padding:12px;display:none}
  .filter-panel.open{display:block;animation:pop .2s ease}
  .fp-head{display:flex;align-items:center;gap:8px;padding:4px 6px 12px;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--faint)}
  .fp-head svg{width:14px;height:14px}
  .fp-head .x{margin-left:auto;width:30px;height:30px;border-radius:8px;display:grid;place-items:center;cursor:pointer;color:var(--muted);border:1px solid var(--line-2);background:var(--panel-2)}
  .fp-head .x:hover{color:var(--ink);background:var(--panel-3)}.fp-head .x svg{width:15px;height:15px}
  .bn-all{display:flex;align-items:center;gap:9px;padding:10px 11px;border-radius:11px;cursor:pointer;font-size:14px;font-weight:600;color:var(--ink);transition:.18s;margin-bottom:4px}
  .bn-all:hover{background:var(--panel-3)}.bn-all.active{background:var(--teal-soft);color:var(--teal-text)}
  .bn-all svg{width:16px;height:16px}.bn-all .cnt{margin-left:auto;font-family:var(--mono);font-size:11.5px;color:var(--faint)}.bn-all.active .cnt{color:var(--teal-text)}
  .bn-sec{padding:14px 10px 6px;font-size:10.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:var(--faint);border-top:1px solid var(--line);margin-top:6px}
  .bn-book{display:flex;align-items:center;gap:8px;padding:9px 11px;border-radius:10px;cursor:pointer;font-size:14px;font-weight:600;color:var(--ink);transition:.18s}
  .bn-book:hover{background:var(--panel-3)}.bn-book.active{background:var(--teal-soft);color:var(--teal-text)}
  .bn-book .bk-ic{width:15px;height:15px;color:var(--teal);opacity:.9;flex:0 0 auto}.bn-book.active .bk-ic{color:var(--teal-text)}
  .bn-book .cnt{margin-left:auto;font-family:var(--mono);font-size:11.5px;color:var(--faint)}
  .bn-chaps{margin:2px 0 6px 10px;padding-left:12px;border-left:1px solid var(--line-2);display:flex;flex-direction:column;gap:1px}
  .bn-chap{display:flex;align-items:baseline;gap:9px;padding:7px 10px;border-radius:9px;cursor:pointer;transition:.18s}
  .bn-chap:hover{background:var(--panel-3)}.bn-chap.active{background:var(--teal-soft)}
  .bn-chap .num{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--muted);min-width:20px}.bn-chap.active .num{color:var(--teal-text)}
  .bn-chap .nm{font-size:13px;color:var(--muted);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bn-chap.active .nm{color:var(--ink)}
  .bn-chap .cnt{font-family:var(--mono);font-size:11px;color:var(--faint)}

  /* GRID / TILES */
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:18px}
  .tile{position:relative;border-radius:16px;overflow:hidden;border:1px solid var(--line-2);background:#000;cursor:pointer;transition:.3s;box-shadow:0 14px 34px -24px rgba(31,33,96,.5)}
  .tile:hover{transform:translateY(-4px);border-color:var(--teal);box-shadow:0 22px 44px -24px rgba(31,33,96,.55)}
  .tile .imgwrap{aspect-ratio:4/3;overflow:hidden}
  .tile img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
  .tile:hover img{transform:scale(1.07)}
  .tile .overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.02) 35%,rgba(10,10,20,.84) 100%);display:flex;flex-direction:column;justify-content:flex-end;padding:14px}
  .tile .t-ref{position:absolute;top:12px;left:12px;display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:8px;font-size:11px;font-weight:700;letter-spacing:.02em;background:rgba(255,255,255,.92);border:1px solid rgba(31,33,96,.1);color:var(--indigo)}
  .tile .t-ref svg{width:11px;height:11px;color:var(--teal-text)}
  .tile .t-title{font-family:var(--serif);font-size:16px;color:#fff;line-height:1.15;margin-bottom:5px}
  .tile .t-meta{display:flex;align-items:center;gap:8px;font-size:11.5px;color:rgba(255,255,255,.72);font-family:var(--mono)}
  .tile .t-actions{position:absolute;top:10px;right:10px;display:flex;gap:8px;opacity:0;transform:translateY(-4px);transition:.25s}
  .tile:hover .t-actions{opacity:1;transform:none}
  .qbtn{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;cursor:pointer;color:var(--indigo);background:rgba(255,255,255,.92);border:1px solid rgba(31,33,96,.1);transition:.2s}
  .qbtn:hover{background:var(--teal);color:#fff;border-color:transparent}.qbtn svg{width:16px;height:16px}

  /* PAGINATION */
  .pagination{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:32px;flex-wrap:wrap}
  .pg{min-width:40px;height:40px;padding:0 11px;border-radius:11px;border:1px solid var(--line-2);background:var(--panel);color:var(--muted);font-weight:600;font-size:14px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px;transition:.18s}
  .pg:hover:not(:disabled):not(.active){color:var(--ink);background:var(--panel-3)}
  .pg.active{background:var(--teal-soft);border-color:rgba(54,177,190,.45);color:var(--teal-text);cursor:default}
  .pg:disabled{opacity:.4;cursor:not-allowed}.pg svg{width:15px;height:15px}
  .pg.ell{border:none;background:none;cursor:default;min-width:24px;color:var(--faint)}
  .pg-info{text-align:center;margin-top:12px;font-size:12.5px;color:var(--faint);font-family:var(--mono)}

  .empty{text-align:center;padding:66px 20px;color:var(--muted);grid-column:1/-1}
  .empty .em-ic{width:56px;height:56px;margin:0 auto 16px;border-radius:16px;display:grid;place-items:center;background:var(--panel);border:1px solid var(--line-2);color:var(--teal)}
  .empty h3{font-family:var(--serif);font-size:20px;color:var(--ink);margin-bottom:6px}.empty p{font-size:14px}

  /* MATERIALS: SERIES BANNER */
  .series-banner{position:relative;overflow:hidden;border-radius:22px;padding:30px 32px;margin-bottom:26px;color:#fff;
    background:linear-gradient(135deg,#2a2c7c,#1a1b55 70%);box-shadow:0 30px 70px -36px rgba(31,33,96,.6)}
  .series-banner::after{content:"";position:absolute;right:-60px;top:-60px;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(127,224,236,.4),transparent 65%);pointer-events:none}
  .sb-grid{position:relative;z-index:1;display:flex;gap:26px;align-items:center;flex-wrap:wrap}
  .sb-left{flex:1;min-width:260px}
  .sb-eyebrow{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan);margin-bottom:10px}
  .sb-title{font-family:var(--serif);font-size:32px;line-height:1.06;margin-bottom:10px}
  .sb-title b{color:var(--cyan);font-weight:400}
  .sb-text{font-size:14.5px;line-height:1.6;color:rgba(255,255,255,.82);max-width:460px}
  .sb-stats{display:flex;gap:22px;margin-top:16px;flex-wrap:wrap}
  .sb-stat b{display:block;font-family:var(--serif);font-size:20px}.sb-stat span{font-size:11.5px;color:rgba(255,255,255,.6);letter-spacing:.03em}
  .sb-right{flex:0 0 auto;width:260px;display:flex;flex-direction:column;gap:14px}
  .sb-langs .ll{font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-bottom:8px}
  .lang-pills{display:flex;flex-wrap:wrap;gap:7px}
  .lpill{display:inline-flex;align-items:center;gap:6px;padding:6px 11px;border-radius:999px;font-size:12.5px;font-weight:600;cursor:pointer;border:1px solid rgba(255,255,255,.22);color:rgba(255,255,255,.85);background:rgba(255,255,255,.06);transition:.18s}
  .lpill:hover{background:rgba(255,255,255,.14)}
  .lpill.active{background:var(--cyan);color:var(--indigo-d);border-color:transparent}
  .lpill.disabled{opacity:.42;cursor:not-allowed}
  .lpill .soon{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;background:rgba(255,255,255,.18);padding:1px 5px;border-radius:5px}
  .sb-dlrow{margin-top:4px}
  .sb-size{font-family:var(--mono);font-size:12px;color:rgba(255,255,255,.7);margin-bottom:9px;display:flex;align-items:center;gap:7px}
  .sb-size svg{width:14px;height:14px;color:var(--cyan)}
  .btn-series{width:100%;height:50px;border:none;border-radius:13px;cursor:pointer;font-size:14.5px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:9px;background:var(--cyan);color:var(--indigo-d);transition:.2s}
  .btn-series:hover{filter:brightness(1.05);transform:translateY(-1px)}.btn-series svg{width:17px;height:17px}

  /* MATERIALS: GROUP TABS */
  .mat-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px;border-bottom:1px solid var(--line);padding-bottom:0}
  .mtab{display:inline-flex;align-items:center;gap:8px;padding:11px 15px;border-radius:11px 11px 0 0;font-size:14px;font-weight:600;color:var(--muted);cursor:pointer;transition:.18s;border-bottom:2px solid transparent;margin-bottom:-1px}
  .mtab:hover{color:var(--ink);background:var(--panel-3)}
  .mtab.active{color:var(--indigo);border-bottom-color:var(--teal);background:var(--panel)}
  .mtab svg{width:16px;height:16px}
  .mtab .mc{font-family:var(--mono);font-size:11px;color:var(--faint);background:var(--panel-3);border-radius:20px;padding:1px 7px}
  .mtab.active .mc{color:var(--teal-text);background:var(--teal-soft)}

  .mat-catsec{margin-bottom:26px}
  .mat-cathead{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);margin-bottom:13px;display:flex;align-items:center;gap:9px}
  .mat-cathead::after{content:"";flex:1;height:1px;background:var(--line)}

  /* MATERIAL CARD */
  .mcard{border:1px solid var(--line-2);border-radius:16px;overflow:hidden;background:var(--panel);display:flex;flex-direction:column;transition:.3s;box-shadow:0 12px 30px -24px rgba(31,33,96,.45)}
  .mcard:hover{transform:translateY(-4px);border-color:var(--teal)}
  .mthumb{position:relative;aspect-ratio:16/9;overflow:hidden;background:#000}
  .mthumb img{width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
  .mcard:hover .mthumb img{transform:scale(1.05)}
  .mbadge{position:absolute;left:10px;bottom:10px;display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border-radius:8px;font-size:11px;font-weight:700;background:rgba(255,255,255,.93);border:1px solid rgba(31,33,96,.08);color:var(--indigo)}
  .mbadge svg{width:12px;height:12px;color:var(--teal-text)}
  .mkind{position:absolute;right:10px;top:10px;padding:5px 9px;border-radius:8px;font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;background:rgba(31,33,96,.82);color:#fff;backdrop-filter:blur(4px)}
  .mbody{padding:15px 16px;display:flex;flex-direction:column;gap:4px;flex:1}
  .mtitle{font-family:var(--serif);font-size:16.5px;color:var(--ink);line-height:1.2}
  .mmeta{font-family:var(--mono);font-size:12px;color:var(--faint);margin-bottom:12px}
  .mdl{margin-top:auto;height:42px;border-radius:11px;border:1px solid var(--line-2);background:var(--panel);color:var(--indigo);font-weight:700;font-size:14px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:.2s}
  .mdl:hover{background:var(--indigo);color:#fff;border-color:transparent}.mdl svg{width:16px;height:16px}

  /* IMAGES GROUP CTA */
  .img-cta{border:1px dashed var(--line-2);border-radius:18px;padding:40px 30px;text-align:center;background:var(--panel-2)}
  .img-cta .ic-ic{width:60px;height:60px;margin:0 auto 18px;border-radius:16px;display:grid;place-items:center;background:var(--teal-soft);border:1px solid rgba(54,177,190,.3);color:var(--teal-text)}
  .img-cta .ic-ic svg{width:28px;height:28px}
  .img-cta h3{font-family:var(--serif);font-size:22px;color:var(--ink);margin-bottom:8px}
  .img-cta p{font-size:14px;color:var(--muted);max-width:420px;margin:0 auto 20px;line-height:1.55}
  .img-cta .btn{display:inline-flex;width:auto;padding:0 22px;height:46px}

  /* SEARCH */
  .chip{padding:8px 14px;border-radius:999px;font-size:13px;font-weight:600;color:var(--muted);cursor:pointer;background:var(--panel);border:1px solid var(--line-2);transition:.2s;white-space:nowrap}
  .chip:hover{color:var(--ink);background:var(--panel-3);border-color:var(--teal)}
  .search-hero{max-width:680px;margin:10px auto 30px;text-align:center}
  .search-hero h1{font-family:var(--serif);font-size:30px;color:var(--ink);margin-bottom:6px}
  .search-hero p{color:var(--muted);font-size:14px;margin-bottom:22px}
  .searchbig{display:flex;align-items:center;gap:12px;height:58px;padding:0 18px;border-radius:16px;background:var(--panel);border:1px solid var(--line-2);transition:.2s}
  .searchbig.focus{border-color:var(--teal);box-shadow:0 0 0 4px var(--teal-soft)}
  .searchbig svg{width:20px;height:20px;color:var(--muted);flex:0 0 auto}
  .searchbig input{flex:1;background:none;border:none;outline:none;color:var(--ink);font-size:16px;font-family:var(--sans)}
  .searchbig input::placeholder{color:var(--faint)}
  .searchbig .clr{cursor:pointer;color:var(--faint);width:22px;height:22px;border-radius:6px;display:none;place-items:center}
  .searchbig .clr:hover{color:var(--ink);background:var(--panel-3)}
  .search-sug{margin-top:16px}
  .search-sug .lbl{font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--faint);margin-bottom:10px;text-align:center}
  .search-sug .row{display:flex;gap:9px;flex-wrap:wrap;justify-content:center}
  .result-head{display:flex;align-items:center;gap:10px;margin-bottom:16px;color:var(--muted);font-size:14px}.result-head b{color:var(--ink);font-weight:700}

  /* DETAIL */
  .det-top{display:flex;align-items:center;gap:14px;margin-bottom:20px}
  .backbtn{width:40px;height:40px;border-radius:11px;background:var(--panel);border:1px solid var(--line-2);color:var(--muted);display:grid;place-items:center;cursor:pointer;transition:.2s;flex:0 0 auto}
  .backbtn:hover{color:var(--ink);background:var(--panel-3)}
  .layout{display:grid;grid-template-columns:1.35fr 1fr;gap:22px;align-items:start}
  .col-left{display:flex;flex-direction:column;gap:22px;min-width:0}
  .viewer{position:relative;border-radius:var(--radius);overflow:hidden;border:1px solid var(--line-2);background:#000;box-shadow:0 30px 70px -36px rgba(31,33,96,.5)}
  .viewer .frame{position:relative;cursor:zoom-in;display:block}.viewer img{display:block;width:100%;height:auto}
  .badge-res{position:absolute;left:14px;bottom:14px;display:inline-flex;align-items:center;gap:8px;padding:7px 12px;border-radius:10px;font-family:var(--mono);font-size:12px;background:rgba(255,255,255,.93);border:1px solid rgba(31,33,96,.1);color:var(--indigo)}
  .badge-live{position:absolute;right:14px;top:14px;display:inline-flex;align-items:center;gap:7px;padding:6px 11px 6px 9px;border-radius:999px;font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;background:rgba(255,255,255,.93);border:1px solid rgba(54,177,190,.4);color:var(--teal-text)}
  .badge-live .p{width:7px;height:7px;border-radius:50%;background:var(--teal);box-shadow:0 0 9px var(--teal)}
  .prompt-card{border:1px solid var(--line-2);border-radius:14px;overflow:hidden;background:var(--panel)}
  .prompt-head{display:flex;align-items:center;gap:10px;padding:13px 16px;border-bottom:1px solid var(--line)}
  .prompt-head .k{display:inline-flex;align-items:center;gap:8px}.prompt-head .k svg{width:14px;height:14px;color:var(--teal-text)}
  .lbl{font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--faint)}
