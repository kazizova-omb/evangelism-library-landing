<script>
  import * as api from '../scripts/api';
  import { mountTurnstile } from '../scripts/turnstile';
  import { isValidEmail, suggestEmail } from '../lib/email';
  import { track } from '../scripts/analytics';

  type P = Record<string, any>;
  const T = JSON.parse(document.getElementById('portal-text')!.textContent ?? '{}') as P;
  const lang = document.getElementById('shell')!.dataset.lang ?? 'en';
  const $ = <E extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as E;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const fill = (t: string, v: Record<string, string | number>) => t.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
  const PAGE_SIZE = 8;
  const ICON = {
    book: 'M12 2v20M5 8l7-4 7 4M5 8v11h14V8',
    dl: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3',
    x: 'M18 6 6 18M6 6l12 12',
    grid: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z',
    img: 'M3 3h18v18H3zM3 15l5-5 4 4 4-4 5 5',
    prev: 'M15 18l-6-6 6-6', next: 'M9 18l6-6-6-6',
    deck: 'M3 4h18v12H3zM8 20h8M12 16v4', video: 'M23 7l-7 5 7 5V7zM1 5h15v14H1z', audio: 'M9 18V5l12-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z', mkt: 'M3 11l19-9-9 19-2-8-8-2z',
    copy: 'M9 9h12v12H9zM5 15V5a2 2 0 0 1 2-2h10', link: 'M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1',
    term: 'M4 17l6-6-6-6M12 19h8', star: 'M12 3l2.5 5.5L20 11l-5.5 2.5L12 19l-2.5-5.5L4 11l5.5-2.5z', search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-4-4',
    purposes: {
      personal: 'M20 21a8 8 0 1 0-16 0M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z', ministry: 'M12 2v20M5 8l7-4 7 4M5 8v11h14V8',
      social: 'M18 8a3 3 0 1 0-2.8-4M6 12a3 3 0 1 0 0 .01M18 16a3 3 0 1 0-2.8 2M8.6 13.5l6.8 4M15.2 6.5l-6.8 4', sermon: 'M3 4h18v12H3zM8 20h8M12 16v4',
      web: 'M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z', print: 'M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2M6 14h12v8H6z', other: 'M12 5v14M5 12h14',
    } as Record<string, string>,
  };
  const ic = (d: string, attrs = '') => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" ${attrs}><path d="${d}"/></svg>`;

  /* ---------------- state ---------------- */
  let user: api.User | null = null;
  let facets: api.LibraryFacets | null = null;
  let materials: api.Materials | null = null;
  let activeBook: string | null = null, activeChapter: number | null = null, activeCat: string | null = null, page = 1;
  let matGroup: string = 'presentations';
  let seriesLang = lang;
  let pending: (() => void) | null = null;
  let returnHash = '#library';
  const imageCache = new Map<string, api.LibraryImage>();

  function toast(m: string) {
    const t = $('toast'); $('toast-msg').textContent = m; t.classList.add('show');
    clearTimeout((t as any)._t); (t as any)._t = setTimeout(() => t.classList.remove('show'), 2200);
  }

  /* ---------------- session ---------------- */
  function setUser(u: api.User | null) {
    user = u;
    document.body.classList.toggle('is-authed', !!u);
    const letter = ((u?.firstName || u?.email || 'A')[0] ?? 'A').toUpperCase();
    $('avatar').textContent = letter; $('pm-av').textContent = letter;
    $('pm-email').textContent = u?.email ?? '';
  }
  /** downloading needs a session: remember what the visitor wanted, sign in, then carry on */
  function needAuth(action: () => void): boolean {
    if (user) return true;
    pending = action; returnHash = location.hash || '#library';
    toast(T.toast.signInToDownload);
    location.hash = '#login';
    return false;
  }
  $('sign-out').addEventListener('click', async () => {
    closeProfile(); await api.logout().catch(() => {}); setUser(null); toast(T.toast.signedOut); location.hash = '#library';
  });

  /* ---------------- popovers ---------------- */
  function place(panel: HTMLElement, trigger: HTMLElement) {
    if (matchMedia('(max-width:640px)').matches) { panel.style.cssText = ''; return; }
    const r = trigger.getBoundingClientRect();
    panel.style.left = 'auto'; panel.style.bottom = 'auto'; panel.style.top = `${r.bottom + 10}px`; panel.style.right = `${innerWidth - r.right}px`;
  }
  function setFilterOpen(o: boolean) {
    $('filter-panel').classList.toggle('open', o); $('filter-btn').classList.toggle('open', o); $('filter-overlay').classList.toggle('open', o);
    $('filter-btn').setAttribute('aria-expanded', String(o));
  }
  const closeFilter = () => setFilterOpen(false);
  function closeProfile() { $('profile-menu').classList.remove('open'); $('profile-overlay').classList.remove('open'); }
  $('filter-btn').addEventListener('click', () => {
    const open = !$('filter-panel').classList.contains('open'); closeProfile();
    if (open) { buildFilterPanel(); place($('filter-panel'), $('filter-btn')); }
    setFilterOpen(open);
  });
  $('filter-overlay').addEventListener('click', closeFilter);
  $('avatar').addEventListener('click', () => {
    const m = $('profile-menu'); const open = !m.classList.contains('open'); closeFilter();
    if (open) place(m, $('avatar'));
    m.classList.toggle('open', open); $('profile-overlay').classList.toggle('open', open);
  });
  $('profile-overlay').addEventListener('click', closeProfile);
  $('profile-menu').addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) closeProfile(); });
  addEventListener('resize', () => { closeFilter(); closeProfile(); });

  /* ---------------- router: #library, #materials, #search, #image/<id>, #login ---------------- */
  const VIEWS = ['login', 'library', 'materials', 'search', 'image'];
  function router() {
    closeFilter(); closeProfile();
    const [raw, id] = (location.hash || '#library').slice(1).split('/');
    const view = VIEWS.includes(raw) ? raw : 'library';
    VIEWS.forEach((v) => $(`v-${v}`).classList.toggle('on', v === view));
    document.querySelectorAll<HTMLElement>('.navlink').forEach((n) => {
      const on = n.dataset.nav === view || (view === 'image' && n.dataset.nav === 'library');
      n.classList.toggle('active', on); if (on) n.setAttribute('aria-current', 'page'); else n.removeAttribute('aria-current');
    });
    if (view === 'login') { if (user) { location.hash = returnHash; return; } showEmailStep(); setTimeout(() => $('email').focus(), 50); }
    if (view === 'library') renderLibrary();
    if (view === 'materials') renderMaterials();
    if (view === 'search') { renderSearch(); setTimeout(() => $('search-input').focus(), 50); }
    if (view === 'image') renderDetail(decodeURIComponent(id ?? ''));
    scrollTo(0, 0);
  }
  addEventListener('hashchange', router);
  document.querySelectorAll<HTMLElement>('[data-nav]').forEach((b) => b.addEventListener('click', () => { location.hash = `#${b.dataset.nav}`; }));
  document.querySelectorAll<HTMLElement>('[data-go]').forEach((b) => b.addEventListener('click', () => {
    if (b.dataset.go === 'login') returnHash = location.hash && location.hash !== '#login' ? location.hash : '#library';
    location.hash = `#${b.dataset.go}`;
  }));
  document.addEventListener('keydown', (e) => {
    const tag = (document.activeElement as HTMLElement)?.tagName;
    if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA') { e.preventDefault(); location.hash = '#search'; }
    if (e.key === 'Escape') { closeDownload(); closeLB(); closeFilter(); closeProfile(); }
  });

  /* ---------------- sign-in: email -> 6-digit code ---------------- */
  const emailInput = $<HTMLInputElement>('email');
  const ts = mountTurnstile($('ts-box'), () => {});
  emailInput.addEventListener('focus', ts.load, { once: true });
  let pendingEmail = '';
  const otp = [...document.querySelectorAll<HTMLInputElement>('#otp input')];

  function showErr(id: string, html: string | null) { const el = $(id); el.innerHTML = html ?? ''; el.classList.toggle('show', !!html); }
  function showEmailStep() { $('step-code').hidden = true; $('step-email').hidden = false; showErr('email-err', null); }
  function showCodeStep() {
    $('code-text').innerHTML = fill(T.login.codeText, { email: `<span class="emailtag">${esc(pendingEmail)}</span>` });
    $('step-email').hidden = true; $('step-code').hidden = false; showErr('code-err', null);
    otp.forEach((b) => { b.value = ''; }); otp[0].focus();
  }
  $('back-to-email').addEventListener('click', showEmailStep);

  emailInput.addEventListener('blur', () => {
    const fix = suggestEmail(emailInput.value);
    const box = $('email-suggest');
    if (!fix) { box.hidden = true; return; }
    const [before, after] = (T.login.suggest as string).split('{email}');
    const b = Object.assign(document.createElement('button'), { type: 'button', textContent: fix });
    b.addEventListener('click', () => { emailInput.value = fix; box.hidden = true; emailInput.focus(); });
    box.replaceChildren(document.createTextNode(before ?? ''), b, document.createTextNode(after ?? '')); box.hidden = false;
  });
  emailInput.addEventListener('input', () => { $('email-field').classList.remove('is-err'); emailInput.classList.remove('err'); });

  async function sendCode(resend = false) {
    const v = emailInput.value.trim();
    if (!isValidEmail(v)) { $('email-field').classList.add('is-err'); emailInput.classList.add('err'); emailInput.focus(); return; }
    const token = ts.token();
    if (!token) { ts.load(); showErr('email-err', esc(T.login.turnstileError)); return; }
    const btn = $<HTMLButtonElement>('send-code'); btn.disabled = true; btn.querySelector('span')!.textContent = T.login.sending;
    pendingEmail = v.replace(/@(.+)$/, (_, d: string) => '@' + d.toLowerCase());
    try {
      await api.requestCode(pendingEmail, lang, token);
      showCodeStep(); if (resend) toast(T.toast.codeResent);
    } catch (err) {
      showEmailStep();
      showErr('email-err', err instanceof api.ApiError && err.code === 'not_registered'
        ? `${esc(T.login.notRegistered)} <a href="${esc(T.register)}">${esc(T.login.register)}</a>` : esc(T.login.networkError));
    } finally {
      btn.disabled = false; btn.querySelector('span')!.textContent = T.login.continue; ts.reset();
    }
  }
  $('step-email').addEventListener('submit', (e) => { e.preventDefault(); showErr('email-err', null); sendCode(); });
  // a new code needs a fresh spam check: back to the email step with the address kept
  $('resend').addEventListener('click', (e) => { e.preventDefault(); showEmailStep(); emailInput.value = pendingEmail; $('send-code').focus(); });

  otp.forEach((box, i) => {
    box.addEventListener('input', () => { box.value = box.value.replace(/\D/g, '').slice(-1); if (box.value && i < otp.length - 1) otp[i + 1].focus(); showErr('code-err', null); });
    box.addEventListener('keydown', (e) => { if (e.key === 'Backspace' && !box.value && i > 0) otp[i - 1].focus(); });
    box.addEventListener('paste', (e) => {
      e.preventDefault();
      const d = (e.clipboardData?.getData('text') ?? '').replace(/\D/g, '').slice(0, 6);
      d.split('').forEach((c, j) => { if (otp[j]) otp[j].value = c; });
      (otp[Math.min(d.length, 5)] ?? box).focus();
    });
  });
  $('step-code').addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = otp.map((b) => b.value).join('');
    if (code.length < 6) { showErr('code-err', esc(T.login.codeError)); otp[Math.min(code.length, 5)].focus(); return; }
    const btn = $<HTMLButtonElement>('verify'); btn.disabled = true; btn.textContent = T.login.verifying;
    try {
      setUser(await api.verifyCode(pendingEmail, code));
      track('portal_sign_in'); toast(T.toast.signedIn);
      const act = pending; pending = null;
      location.hash = returnHash || '#library';
      if (act) setTimeout(act, 120);
    } catch (err) {
      const c = err instanceof api.ApiError ? err.code : '';
      showErr('code-err', esc(c === 'expired_code' ? T.login.expired : c === 'invalid_code' ? T.login.invalid : T.login.networkError));
      otp.forEach((b) => { b.value = ''; }); otp[0].focus();
    } finally {
      btn.disabled = false; btn.textContent = T.login.verify;
    }
  });

  /* ---------------- image library ---------------- */
  async function ensureFacets() { facets ??= await api.facets(lang); return facets; }

  function buildFilterPanel() {
    const f = facets; if (!f) return;
    const tests: Record<string, api.LibraryBook[]> = {};
    f.books.forEach((b) => (tests[b.testament] ??= []).push(b));
    let html = `<div class="fp-head">${ic('M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z')}${esc(T.library.browseBy)}<button type="button" class="x" data-close aria-label="${esc(T.dl.close)}">${ic(ICON.x)}</button></div>`;
    html += `<button type="button" class="bn-all${!activeBook && !activeCat ? ' active' : ''}" data-all>${ic(ICON.grid)}${esc(T.library.all)}<span class="cnt">${f.total}</span></button>`;
    (['Old', 'New'] as const).filter((k) => tests[k]).forEach((k) => {
      html += `<div class="bn-sec">${esc(k === 'Old' ? T.library.old : T.library.new)}</div>`;
      tests[k].forEach((b) => {
        const on = activeBook === b.book;
        html += `<button type="button" class="bn-book${on && !activeChapter ? ' active' : ''}" data-book="${esc(b.book)}">${ic(ICON.book, 'class="bk-ic"')}${esc(b.book)}<span class="cnt">${b.count}</span></button><div class="bn-chaps">`;
        b.chapters.forEach((c) => {
          html += `<button type="button" class="bn-chap${on && activeChapter === c.n ? ' active' : ''}" data-book="${esc(b.book)}" data-chapter="${c.n}"><span class="num">${c.n}</span><span class="nm">${esc(c.name)}</span><span class="cnt">${c.count}</span></button>`;
        });
        html += '</div>';
      });
    });
    $('filter-panel').innerHTML = html;
  }
  $('filter-panel').addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('button'); if (!t) return;
    if (t.hasAttribute('data-close')) { closeFilter(); return; }
    if (t.hasAttribute('data-all')) { activeBook = null; activeChapter = null; activeCat = null; }
    else if (t.dataset.book) { activeBook = t.dataset.book; activeChapter = t.dataset.chapter ? Number(t.dataset.chapter) : null; activeCat = null; }
    page = 1; closeFilter(); renderLibrary();
  });

  function renderCatRail() {
    const cats = facets?.categories ?? [];
    $('cat-rail').innerHTML = cats.map((c) => {
      const n = c.count ?? 0;
      const badge = n > 0 ? `<span class="ct-cnt">${n}</span>` : `<span class="ct-soon">${esc(T.library.soon)}</span>`;
      return `<button type="button" class="cat-tile${activeCat === c.id ? ' active' : ''}" data-cat="${esc(c.id)}" aria-pressed="${activeCat === c.id}"><div class="ct-img"><img src="${esc(c.thumb)}" alt="" loading="lazy"></div><div class="ct-body"><span class="ct-name">${esc(c.label)}</span>${badge}</div></button>`;
    }).join('');
  }
  $('cat-rail').addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-cat]'); if (!t) return;
    activeCat = activeCat === t.dataset.cat ? null : t.dataset.cat!; activeBook = null; activeChapter = null; page = 1; renderLibrary();
  });
  $<HTMLSelectElement>('sort').addEventListener('change', () => { page = 1; renderLibrary(); });

  function tileHTML(d: api.LibraryImage) {
    imageCache.set(d.id, d);
    return `<div class="tile" role="link" tabindex="0" data-open="${esc(d.id)}">
      <div class="imgwrap"><img src="${esc(d.preview)}" alt="${esc(d.title)}" loading="lazy"></div>
      <span class="t-ref">${ic(ICON.book)}${esc(d.book)} ${d.chapter}</span>
      <div class="t-actions"><button type="button" class="qbtn" title="${esc(T.library.download)}" aria-label="${esc(T.library.download)}: ${esc(d.title)}" data-dl="${esc(d.id)}">${ic(ICON.dl)}</button></div>
      <div class="overlay"><div class="t-title">${esc(d.title)}</div><div class="t-meta">${esc([d.model, d.dims].filter(Boolean).join(' · '))}</div></div>
    </div>`;
  }
  // tiles: open the image page, or download straight from the tile
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const dl = t.closest<HTMLElement>('[data-dl]'); if (dl) { e.stopPropagation(); openDownloadImage(dl.dataset.dl!); return; }
    const open = t.closest<HTMLElement>('[data-open]'); if (open) location.hash = `#image/${encodeURIComponent(open.dataset.open!)}`;
  });
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if ((e.key === 'Enter' || e.key === ' ') && t.matches?.('[data-open]')) { e.preventDefault(); location.hash = `#image/${encodeURIComponent(t.dataset.open!)}`; }
  });

  function renderChips() {
    const el = $('active-chips'); const btn = $('filter-btn'); const lbl = $('filter-btn-label');
    lbl.textContent = T.library.filter; btn.classList.remove('active');
    const chip = (icon: string, label: string, sub: string) => `<div class="fchip"><span class="body">${ic(icon, 'class="fi"')}${esc(label)}${sub ? `<span class="sub">${esc(sub)}</span>` : ''}</span><button type="button" class="xx" data-clear title="${esc(T.library.clear)}" aria-label="${esc(T.library.clear)}">${ic(ICON.x, 'stroke-width="2.4"')}</button></div>`;
    if (activeCat) {
      const c = facets?.categories.find((x) => x.id === activeCat);
      el.innerHTML = chip(ICON.img, c?.label ?? activeCat, T.library.categoryTag); return;
    }
    if (!activeBook) { el.innerHTML = ''; return; }
    btn.classList.add('active');
    const label = activeBook + (activeChapter ? ` ${activeChapter}` : ''); lbl.textContent = label;
    const b = facets?.books.find((x) => x.book === activeBook);
    const sub = activeChapter ? b?.chapters.find((c) => c.n === activeChapter)?.name ?? '' : fill(T.library.chapters, { n: b?.chapters.length ?? 0 });
    el.innerHTML = chip(ICON.book, label, sub);
  }
  $('active-chips').addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-clear]')) { activeBook = null; activeChapter = null; activeCat = null; page = 1; renderLibrary(); }
  });

  let libReq = 0;
  async function renderLibrary() {
    const req = ++libReq;
    try {
      await ensureFacets();
      renderCatRail(); renderChips();
      const res = await api.images({ book: activeBook ?? undefined, chapter: activeChapter ?? undefined, category: activeCat ?? undefined, sort: $<HTMLSelectElement>('sort').value as api.LibraryQuery['sort'], page, perPage: PAGE_SIZE }, lang);
      if (req !== libReq) return;
      const grid = $('library-grid');
      grid.innerHTML = res.items.length ? res.items.map(tileHTML).join('')
        : `<div class="empty"><div class="em-ic">${ic(ICON.book, 'width="26" height="26"')}</div><h3>${esc(T.library.emptyTitle)}</h3><p>${esc(T.library.emptyText)}</p></div>`;
      const ctx = activeCat ? facets?.categories.find((c) => c.id === activeCat)?.label : activeBook ? activeBook + (activeChapter ? ` ${activeChapter}` : '') : null;
      $('library-count').textContent = ctx ? fill(T.library.countIn, { n: res.total, ctx }) : fill(T.library.countAll, { n: res.total });
      renderPagination(res.total);
    } catch {
      $('library-grid').innerHTML = `<div class="empty"><h3>${esc(T.library.loadError)}</h3><button type="button" class="btn btn-ghost" data-retry>${esc(T.library.retry)}</button></div>`;
      $('library-grid').querySelector('[data-retry]')?.addEventListener('click', renderLibrary);
    }
  }
  function renderPagination(total: number) {
    const pages = Math.max(1, Math.ceil(total / PAGE_SIZE)); const pag = $('pagination'); const info = $('pg-info');
    if (total <= PAGE_SIZE) { pag.innerHTML = ''; info.textContent = ''; return; }
    const start = (page - 1) * PAGE_SIZE + 1, end = Math.min(page * PAGE_SIZE, total);
    const nums: (number | '…')[] = [];
    for (let i = 1; i <= pages; i++) { if (i === 1 || i === pages || Math.abs(i - page) <= 1) nums.push(i); else if (nums[nums.length - 1] !== '…') nums.push('…'); }
    pag.innerHTML = `<button type="button" class="pg" data-page="${page - 1}" ${page === 1 ? 'disabled' : ''} aria-label="${esc(T.library.prev)}">${ic(ICON.prev)}</button>`
      + nums.map((n) => n === '…' ? '<span class="pg ell">…</span>' : `<button type="button" class="pg${n === page ? ' active' : ''}" data-page="${n}" ${n === page ? 'aria-current="page"' : ''}>${n}</button>`).join('')
      + `<button type="button" class="pg" data-page="${page + 1}" ${page === pages ? 'disabled' : ''} aria-label="${esc(T.library.next)}">${ic(ICON.next)}</button>`;
    info.textContent = fill(T.library.showing, { from: start, to: end, total });
  }
  $('pagination').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-page]'); if (!b || b.disabled) return;
    page = Number(b.dataset.page); renderLibrary(); $('v-library').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  /* ---------------- materials ---------------- */
  const GROUP_ICON: Record<string, string> = { presentations: ICON.deck, video: ICON.video, marketing: ICON.mkt, audio: ICON.audio, book: ICON.book, images: ICON.img };
  const groupLabel = (id: string) => T.materials[id] ?? id;
  const kindLabel = (id: string) => T.materials[`kind${id[0].toUpperCase()}${id.slice(1)}`] ?? '';
  function itemMeta(g: string, it: api.MaterialItem) {
    const first = g === 'presentations' ? fill(T.materials.slides, { n: it.slides ?? 0 }) : (g === 'video' || g === 'audio') ? it.duration ?? '' : it.fileType ?? '';
    return { first, full: [first, it.size].filter(Boolean).join(' · ') };
  }
  async function renderMaterials() {
    try {
      materials ??= await api.materials(lang);
      await ensureFacets();
    } catch { $('mat-content').innerHTML = `<div class="empty"><h3>${esc(T.library.loadError)}</h3></div>`; return; }
    const m = materials;
    $('sb-stats').innerHTML = [[m.series.sessions, T.materials.sessions], [m.series.files, T.materials.files], [m.series.formats, T.materials.formats]]
      .map(([n, l]) => `<div class="sb-stat"><b>${esc(n)}</b><span>${esc(String(l).toUpperCase())}</span></div>`).join('');
    $('series-size').textContent = fill(T.materials.fullSeries, { size: m.series.size });
    if (!m.languages.some((l) => l.code === seriesLang && l.available)) seriesLang = m.languages.find((l) => l.available)?.code ?? 'en';
    $('lang-pills').innerHTML = m.languages.map((l) => l.available
      ? `<button type="button" class="lpill${l.code === seriesLang ? ' active' : ''}" data-lang="${esc(l.code)}" aria-pressed="${l.code === seriesLang}">${esc(l.name)}</button>`
      : `<span class="lpill disabled" title="${esc(T.materials.soon)}">${esc(l.name)}<span class="soon">${esc(T.materials.soon)}</span></span>`).join('');
    const groups = [...m.groups.map((g) => ({ id: g.id as string, n: g.items.length })), { id: 'images', n: facets?.total ?? 0 }];
    if (!groups.some((g) => g.id === matGroup)) matGroup = groups[0].id;
    $('mat-tabs').innerHTML = groups.map((g) => `<button type="button" role="tab" class="mtab${g.id === matGroup ? ' active' : ''}" aria-selected="${g.id === matGroup}" data-group="${g.id}">${ic(GROUP_ICON[g.id] ?? ICON.deck)}${esc(groupLabel(g.id))}<span class="mc">${g.n}</span></button>`).join('');
    renderMatContent();
  }
  function renderMatContent() {
    const c = $('mat-content');
    if (matGroup === 'images') {
      c.innerHTML = `<div class="img-cta"><div class="ic-ic">${ic(ICON.img)}</div><h3>${esc(T.materials.imagesTitle)}</h3><p>${esc(T.materials.imagesText)}</p><a class="btn btn-primary" href="#library">${esc(T.materials.openLibrary)}</a></div>`;
      return;
    }
    const items = materials?.groups.find((g) => g.id === matGroup)?.items ?? [];
    const cats = [...new Set(items.map((i) => i.cat))];
    c.innerHTML = cats.map((cat) => `<div class="mat-catsec"><div class="mat-cathead">${esc(cat)}</div><div class="grid">${items.filter((i) => i.cat === cat).map((it) => {
      const meta = itemMeta(matGroup, it);
      return `<div class="mcard"><div class="mthumb"><img src="${esc(it.thumb)}" alt="" loading="lazy"><span class="mbadge">${ic(GROUP_ICON[matGroup] ?? ICON.deck)}${esc(meta.first)}</span><span class="mkind">${esc(kindLabel(matGroup))}</span></div>
        <div class="mbody"><div class="mtitle">${esc(it.title)}</div><div class="mmeta">${esc(meta.full)}</div>
        <button type="button" class="mdl" data-mat="${esc(it.id)}">${ic(ICON.dl)}${esc(T.materials.download)}</button></div></div>`;
    }).join('')}</div></div>`).join('');
  }
  $('mat-tabs').addEventListener('click', (e) => { const t = (e.target as HTMLElement).closest<HTMLElement>('[data-group]'); if (!t) return; matGroup = t.dataset.group!; renderMaterials(); });
  $('lang-pills').addEventListener('click', (e) => { const t = (e.target as HTMLElement).closest<HTMLElement>('[data-lang]'); if (!t) return; seriesLang = t.dataset.lang!; renderMaterials(); });
  $('mat-content').addEventListener('click', (e) => { const t = (e.target as HTMLElement).closest<HTMLElement>('[data-mat]'); if (t) openDownloadMaterial(t.dataset.mat!); });
  $('dl-series').addEventListener('click', () => openDownloadSeries());

  /* ---------------- search ---------------- */
  const searchInput = $<HTMLInputElement>('search-input');
  let searchTimer = 0, searchReq = 0;
  async function renderSearch() {
    await ensureFacets().catch(() => null);
    $('sug-row').innerHTML = (facets?.tags ?? []).map((t) => `<button type="button" class="chip" data-tag="${esc(t)}">${esc(t)}</button>`).join('');
    const q = searchInput.value.trim();
    $('search-clr').style.display = q ? 'grid' : 'none'; $('search-sug').style.display = q ? 'none' : 'block';
    const res = $('search-results');
    if (!q) { res.innerHTML = ''; return; }
    const req = ++searchReq;
    const out = await api.images({ q, page: 1, perPage: 48 }, lang).catch(() => null);
    if (req !== searchReq) return;
    if (!out) { res.innerHTML = `<div class="empty"><h3>${esc(T.library.loadError)}</h3></div>`; return; }
    if (!out.total) { res.innerHTML = `<div class="empty"><div class="em-ic">${ic(ICON.search, 'width="26" height="26"')}</div><h3>${esc(T.search.noneTitle)}</h3><p>${esc(fill(T.search.noneText, { q }))}</p></div>`; return; }
    res.innerHTML = `<div class="result-head">${fill(out.total === 1 ? esc(T.search.result) : esc(T.search.results), { n: `<b>${out.total}</b>`, q: esc(q) })}</div><div class="grid">${out.items.map(tileHTML).join('')}</div>`;
  }
  searchInput.addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = window.setTimeout(renderSearch, 180); });
  $('search-clr').addEventListener('click', () => { searchInput.value = ''; renderSearch(); searchInput.focus(); });
  $('sug-row').addEventListener('click', (e) => { const t = (e.target as HTMLElement).closest<HTMLElement>('[data-tag]'); if (t) { searchInput.value = t.dataset.tag!; renderSearch(); } });
  $('searchbig').addEventListener('focusin', () => $('searchbig').classList.add('focus'));
  $('searchbig').addEventListener('focusout', () => $('searchbig').classList.remove('focus'));

  /* ---------------- image page ---------------- */
  async function renderDetail(id: string) {
    const d = imageCache.get(id) ?? await api.image(id, lang).catch(() => null);
    if (!d) { $('det-crumb').textContent = ''; $('detail-body').innerHTML = `<div class="empty"><h3>${esc(T.detail.notFound)}</h3><a class="btn btn-primary" href="#library">${esc(T.detail.back)}</a></div>`; return; }
    imageCache.set(d.id, d);
    $('det-crumb').textContent = d.title;
    const fact = (label: string, value: string, cls = '') => `<div class="fact${cls}"><span class="lbl">${esc(label)}</span>${value}</div>`;
    $('detail-body').innerHTML = `
      <div class="col-left">
        <div class="viewer">
          <button type="button" class="frame" data-zoom aria-label="${esc(T.detail.zoom)}"><img src="${esc(d.image)}" alt="${esc(d.title)}"></button>
          <span class="badge-res">${esc(d.dims)}</span>
        </div>
        ${d.prompt ? `<div class="prompt-card"><div class="prompt-head"><span class="k lbl">${ic(ICON.term)}${esc(T.detail.prompt)}</span><button type="button" class="copy" data-copy>${ic(ICON.copy)}<span>${esc(T.detail.copy)}</span></button></div><div class="prompt-body">${esc(d.prompt)}</div></div>` : ''}
      </div>
      <div class="meta">
        <div class="head-row"><span class="cat-tab">${ic(ICON.star)}${esc(d.group)}</span></div>
        <div><h1 class="det-title">${esc(d.title)}</h1>${d.sub ? `<div class="det-id">${esc(d.sub)}</div>` : ''}</div>
        <button type="button" class="scripture" data-chapter>${ic(ICON.book)}${esc(d.ref)}<span class="ch">${esc(d.chapterName)}</span></button>
        <div class="det-actions">
          <button type="button" class="btn-dl" data-dl="${esc(d.id)}">${ic(ICON.dl)}${esc(T.detail.download)}</button>
          <button type="button" class="btn-sec" data-link title="${esc(T.detail.copyLink)}" aria-label="${esc(T.detail.copyLink)}">${ic(ICON.link, 'width="17" height="17"')}</button>
        </div>
        <div class="divider"></div>
        <div class="facts">
          ${fact(T.detail.dims, `<span class="val mono">${esc(d.dims)} px</span>`)}
          ${fact(T.detail.size, `<span class="val mono">${esc(d.size)}</span>`)}
          ${d.model ? fact(T.detail.model, `<span class="model"><span class="mk">${ic(ICON.star)}</span><span class="mt"><b>${esc(d.model)}</b>${d.modelVersion ? `<span>${esc(d.modelVersion)}</span>` : ''}</span></span>`, ' wide') : ''}
          ${fact(T.detail.created, `<span class="val">${esc(d.date)}</span>`)}
          ${fact(T.detail.license, `<span class="val">${esc(d.license)}</span>`)}
          ${d.tags.length ? fact(T.detail.tags, `<div class="tags">${d.tags.map((t) => `<button type="button" class="tag" data-tag="${esc(t)}"><span class="h">#</span>${esc(t)}</button>`).join('')}</div>`, ' wide') : ''}
          ${d.desc ? fact(T.detail.desc, `<p class="desc">${esc(d.desc)}</p>`, ' wide') : ''}
        </div>
      </div>`;
    const body = $('detail-body');
    body.querySelector('[data-zoom]')?.addEventListener('click', () => openLB(d.image));
    body.querySelector('[data-chapter]')?.addEventListener('click', () => { activeCat = null; activeBook = d.book; activeChapter = d.chapter; page = 1; location.hash = '#library'; });
    body.querySelector('[data-link]')?.addEventListener('click', () => { navigator.clipboard?.writeText(location.href).catch(() => {}); toast(T.toast.linkCopied); });
    body.querySelector('[data-copy]')?.addEventListener('click', (e) => {
      const b = e.currentTarget as HTMLElement; navigator.clipboard?.writeText(d.prompt ?? '').catch(() => {});
      b.classList.add('done'); b.querySelector('span')!.textContent = T.detail.copied;
      setTimeout(() => { b.classList.remove('done'); b.querySelector('span')!.textContent = T.detail.copy; }, 1600);
    });
    body.querySelectorAll<HTMLElement>('[data-tag]').forEach((t) => t.addEventListener('click', () => { searchInput.value = t.dataset.tag!; location.hash = '#search'; }));
  }

  /* ---------------- lightbox ---------------- */
  function openLB(src: string) { $<HTMLImageElement>('lb-img').src = src; $('lb').classList.add('open'); }
  function closeLB() { $('lb').classList.remove('open'); }
  $('lb').addEventListener('click', closeLB);

  /* ---------------- download: purpose + format, progress, receipt ---------------- */
  interface DlCfg { req: Omit<api.DownloadRequest, 'format' | 'purpose' | 'purposeText'>; thumb: string; title: string; sub: string; cta: string; formats: api.FileFormat[]; receipt: (format: string) => [string, string][] }
  let dl: DlCfg | null = null, dlPurpose: string | null = null, dlFormat = '';
  const PURPOSES = T.dl.purposes as { id: string; t: string; s: string }[];

  async function openDownloadImage(id: string) {
    if (!needAuth(() => openDownloadImage(id))) return;
    const d = imageCache.get(id) ?? await api.image(id, lang).catch(() => null); if (!d) return;
    openDownload({ req: { kind: 'image', id, lang }, thumb: d.preview, title: d.title, sub: `${d.ref} · ${d.dims} · ${d.license}`, cta: T.dl.ctaImage, formats: T.imageFormats,
      receipt: (f) => [[T.dl.rTitle, d.title], [T.dl.rPassage, d.ref], [T.dl.rFormat, `${f} · ${d.dims}`], [T.dl.rLicense, d.license]] });
  }
  function openDownloadMaterial(id: string) {
    if (!needAuth(() => openDownloadMaterial(id))) return;
    const g = materials?.groups.find((x) => x.items.some((i) => i.id === id)); const it = g?.items.find((i) => i.id === id); if (!g || !it) return;
    openDownload({ req: { kind: 'material', id, lang }, thumb: it.thumb, title: it.title, sub: `${it.cat} · ${itemMeta(g.id, it).full}`, cta: T.dl.ctaMaterial, formats: it.formats,
      receipt: (f) => [[T.dl.rTitle, it.title], [T.dl.rCategory, it.cat], [T.dl.rFormat, f], [T.dl.rSize, it.size]] });
  }
  function openDownloadSeries() {
    if (!needAuth(() => openDownloadSeries())) return;
    const m = materials; if (!m) return;
    const ln = m.languages.find((l) => l.code === seriesLang) ?? m.languages[0];
    openDownload({ req: { kind: 'series', id: ln.code, lang }, thumb: m.series.thumb, title: T.materials.seriesTitle, sub: `${ln.name} · ${m.series.files} · ${m.series.size}`, cta: T.dl.ctaSeries, formats: m.series.formatsList,
      receipt: (f) => [[T.dl.rPackage, T.materials.seriesTitle], [T.dl.rLanguage, ln.name], [T.dl.rFormat, f], [T.dl.rSize, m.series.size]] });
  }
  function openDownload(cfg: DlCfg) {
    dl = cfg; dlPurpose = null; dlFormat = cfg.formats[0]?.id ?? '';
    $<HTMLImageElement>('dl-thumb').src = cfg.thumb; $('dl-title').textContent = cfg.title; $('dl-sub').textContent = cfg.sub; $('dl-cta').textContent = cfg.cta;
    $('purpose-list').innerHTML = PURPOSES.map((p) => `<button type="button" class="opt" role="radio" aria-checked="false" data-p="${esc(p.id)}"><div class="ic">${ic(ICON.purposes[p.id] ?? ICON.purposes.other, 'stroke-width="1.8"')}</div><div class="txt"><b>${esc(p.t)}</b><span>${esc(p.s)}</span></div><div class="radio"></div></button>`).join('');
    $('fmt-list').innerHTML = cfg.formats.map((f, i) => `<button type="button" class="f${i === 0 ? ' sel' : ''}" role="radio" aria-checked="${i === 0}" data-f="${esc(f.id)}"><b>${esc(f.label)}</b><span>${esc(f.hint ?? '')}</span></button>`).join('');
    $('fmt-list').style.display = cfg.formats.length > 1 ? '' : 'none';
    try { // the last purpose is preselected, people tend to download for the same reason
      const last = localStorage.getItem('rmr-purpose'); if (last && last !== 'other' && PURPOSES.some((p) => p.id === last)) pickPurpose(last);
    } catch { /* ignore */ }
    $('other-wrap').classList.remove('show'); $<HTMLTextAreaElement>('other-text').value = ''; $('dl-warn').classList.remove('show');
    $('dl-form').hidden = false; $('dl-progress').hidden = true; $('dl-done').hidden = true;
    $('dl-modal').classList.add('open');
    setTimeout(() => ($('purpose-list').querySelector('.sel') as HTMLElement ?? $('purpose-list').firstElementChild as HTMLElement)?.focus(), 60);
  }
  function closeDownload() { $('dl-modal').classList.remove('open'); }
  function pickPurpose(id: string) {
    dlPurpose = id;
    $('purpose-list').querySelectorAll<HTMLElement>('.opt').forEach((o) => { const on = o.dataset.p === id; o.classList.toggle('sel', on); o.setAttribute('aria-checked', String(on)); });
    $('other-wrap').classList.toggle('show', id === 'other'); $('dl-warn').classList.remove('show');
    if (id === 'other') setTimeout(() => $('other-text').focus(), 200);
  }
  $('purpose-list').addEventListener('click', (e) => { const o = (e.target as HTMLElement).closest<HTMLElement>('[data-p]'); if (o) pickPurpose(o.dataset.p!); });
  $('fmt-list').addEventListener('click', (e) => {
    const f = (e.target as HTMLElement).closest<HTMLElement>('[data-f]'); if (!f) return;
    dlFormat = f.dataset.f!; $('fmt-list').querySelectorAll<HTMLElement>('.f').forEach((x) => { const on = x.dataset.f === dlFormat; x.classList.toggle('sel', on); x.setAttribute('aria-checked', String(on)); });
  });
  $('dl-close').addEventListener('click', closeDownload);
  $('dl-cancel').addEventListener('click', closeDownload);
  $('dl-done-btn').addEventListener('click', closeDownload);
  $('dl-modal').addEventListener('click', (e) => { if (e.target === $('dl-modal')) closeDownload(); });

  $('dl-form').addEventListener('submit', async (e) => {
    e.preventDefault(); if (!dl) return;
    const warn = $('dl-warn'); const other = $<HTMLTextAreaElement>('other-text').value.trim();
    if (!dlPurpose) { warn.textContent = T.dl.choose; warn.classList.add('show'); return; }
    if (dlPurpose === 'other' && !other) { warn.textContent = T.dl.describe; warn.classList.add('show'); $('other-text').focus(); return; }
    try { localStorage.setItem('rmr-purpose', dlPurpose); } catch { /* ignore */ }
    const purposeLabel = dlPurpose === 'other' ? other : (PURPOSES.find((p) => p.id === dlPurpose)?.t ?? '').toLowerCase();
    const formatLabel = dl.formats.find((f) => f.id === dlFormat)?.label ?? dlFormat;
    $('dl-form').hidden = true; $('dl-progress').hidden = false;
    // the bar moves while the backend prepares the link, and completes when it arrives
    const fillEl = $('dl-fill'), pct = $('dl-pct'); let p = 0; fillEl.style.width = '0%'; pct.textContent = '0%';
    const iv = setInterval(() => { p = Math.min(90, p + Math.random() * 18 + 6); fillEl.style.width = `${p}%`; pct.textContent = `${Math.floor(p)}%`; }, 180);
    try {
      const url = await api.download({ ...dl.req, format: dlFormat, purpose: dlPurpose, purposeText: dlPurpose === 'other' ? other : undefined });
      clearInterval(iv); fillEl.style.width = '100%'; pct.textContent = '100%';
      if (url) { const a = Object.assign(document.createElement('a'), { href: url, download: '', rel: 'noopener' }); document.body.appendChild(a); a.click(); a.remove(); }
      track('portal_download', { kind: dl.req.kind, purpose: dlPurpose, format: dlFormat });
      setTimeout(() => {
        $('dl-progress').hidden = true; $('dl-done').hidden = false;
        $('dl-done-text').innerHTML = fill(esc(T.dl.onWay), { purpose: `<span class="em">${esc(purposeLabel)}</span>` });
        $('dl-receipt').innerHTML = [...dl!.receipt(formatLabel), [T.dl.rPurpose, purposeLabel]].map(([k, v]) => `<div class="rr"><span>${esc(k)}</span><b>${esc(v)}</b></div>`).join('');
        toast(T.toast.downloadStarted);
      }, 300);
    } catch (err) {
      clearInterval(iv);
      if (err instanceof api.ApiError && err.status === 401) { closeDownload(); setUser(null); const again = dl; needAuth(() => again && openDownload(again)); return; }
      $('dl-progress').hidden = true; $('dl-form').hidden = false; warn.textContent = T.dl.failed; warn.classList.add('show');
    }
  });

  /* ---------------- start ---------------- */
  (async () => {
    try { setUser(await api.me()); } catch { setUser(null); }
    if (!location.hash) history.replaceState(null, '', '#library');
    router();
  })();
</script>
