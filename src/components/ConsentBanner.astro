---
import { site } from '../content/site';
import { fill } from '../lib/rich';

const c = site.consent;
const text = fill(c.text, { privacy: `<a href="/privacy">${c.privacyLink}</a>` });
---
<!-- Rendered only when PUBLIC_GA4_ID is set. Fixed position, so showing it causes no layout shift. -->
<section class="consent-banner" id="consentBanner" aria-label={c.label} hidden>
  <p set:html={text} />
  <div class="consent-banner__actions">
    <button type="button" class="btn btn--ghost btn--sm" data-consent="denied">{c.decline}</button>
    <button type="button" class="btn btn--gold btn--sm" data-consent="granted">{c.accept}</button>
  </div>
</section>

<style>
  .consent-banner { position: fixed; left: 50%; bottom: 20px; z-index: 150; transform: translateX(-50%); width: min(720px, calc(100% - 32px)); display: flex; align-items: center; gap: 20px 28px; padding: 18px 20px 18px 24px; border-radius: 16px;
    background: linear-gradient(180deg, #17120D, #0F0C09); box-shadow: 0 0 0 1px var(--line) inset, 0 30px 80px -20px rgba(0, 0, 0, .9); animation: rise .6s var(--ease) }
  .consent-banner p { font-size: 14px; color: var(--ink-2); line-height: 1.5 }
  .consent-banner p :global(a) { color: var(--gold-hi); text-decoration: underline; text-underline-offset: 3px }
  .consent-banner__actions { display: flex; gap: 10px; flex: none }
  @media (max-width: 760px) {
    .consent-banner { flex-direction: column; align-items: stretch; bottom: 16px; padding: 18px }
    .consent-banner__actions .btn { flex: 1 }
  }
</style>

<script>
  import { getConsent, setConsent } from '../scripts/analytics';

  const banner = document.getElementById('consentBanner')!;
  const stored = getConsent();
  if (stored === 'granted') setConsent('granted');
  else if (stored === null) banner.hidden = false;

  banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
    b.addEventListener('click', () => {
      setConsent(b.dataset.consent as 'granted' | 'denied');
      banner.hidden = true;
    }),
  );

  document.querySelectorAll('[data-cookie-settings]').forEach((b) =>
    b.addEventListener('click', () => {
      banner.hidden = false;
      banner.querySelector<HTMLButtonElement>('[data-consent="granted"]')!.focus();
    }),
  );
</script>
