---
import Icon from './Icon.astro';
import { useT } from '../i18n';
import { config } from '../config';

const site = useT(Astro);

const t = site.trailer;
---
<dialog class="modal" id="videoModal" aria-label={t.modalLabel} data-youtube-id={config.trailerYoutubeId} data-video-title={t.videoTitle}>
  <div class="modal__box">
    <button class="modal__close" type="button" data-close aria-label={t.closeLabel}><Icon name="close" /></button>
    <div class="modal__player">
      {!config.trailerYoutubeId && <p>{t.placeholder}</p>}
    </div>
  </div>
</dialog>

<style>
  .modal { position: fixed; inset: 0; z-index: 200; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; border: 0; color: inherit;
    display: grid; place-items: center; padding: 24px; background: rgba(5, 4, 3, .88); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    opacity: 0; transition: opacity .3s }
  .modal:not([open]) { display: none }
  .modal::backdrop { background: transparent }
  .modal.is-open { opacity: 1 }
  .modal__box { position: relative; width: min(1100px, 100%); aspect-ratio: 16/9; border-radius: 8px; background: #000; box-shadow: 0 0 0 1px var(--line); text-align: center; color: var(--muted-solid); font-size: 15px }
  .modal__player { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; border-radius: inherit; overflow: hidden }
  .modal__player :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0 }
  .modal__close { position: absolute; top: -52px; right: 0; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); display: grid; place-items: center }
  .modal__close :global(svg) { width: 16px; height: 16px }
  .modal__close:hover { border-color: var(--gold); color: var(--gold-hi) }
</style>

<script>
  import { track } from '../scripts/analytics';

  const modal = document.getElementById('videoModal') as HTMLDialogElement;
  const player = modal.querySelector<HTMLElement>('.modal__player')!;
  const trigger = document.getElementById('openVideo') as HTMLButtonElement;
  const youtubeId = modal.dataset.youtubeId;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  let returnFocus: HTMLElement | null = null;

  function open() {
    returnFocus = document.activeElement as HTMLElement | null;
    if (youtubeId) {
      const src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtubeId)}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      player.innerHTML = '';
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = modal.dataset.videoTitle ?? '';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      player.appendChild(iframe);
    }
    // showModal() makes the rest of the page inert, so focus is trapped in the dialog
    modal.showModal();
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => modal.classList.add('is-open'));
    modal.querySelector<HTMLElement>('[data-close]')!.focus();
    track('trailer_play');
  }

  function close() {
    if (!modal.open) return;
    modal.classList.remove('is-open');
    const finish = () => {
      modal.close();
      if (youtubeId) player.innerHTML = ''; // removing the iframe stops playback
      document.body.style.overflow = '';
      (returnFocus ?? trigger).focus();
    };
    if (reduced.matches) finish();
    else setTimeout(finish, 300);
  }

  trigger.addEventListener('click', open);
  modal.querySelector('[data-close]')!.addEventListener('click', close);
  // Esc: native "cancel" closes instantly; route it through close() to keep the fade + cleanup
  modal.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
  // Backdrop click: the dialog itself fills the screen, the box is its child
  modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
</script>
