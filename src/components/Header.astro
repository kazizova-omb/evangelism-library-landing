---
import BrandMark from './BrandMark.astro';
import LangSwitch from './LangSwitch.astro';
import { useT, getLang, localePath } from '../i18n';
import { anchor } from '../lib/links';

const site = useT(Astro);
const lang = getLang(Astro);

interface Props { home: boolean }
const { home } = Astro.props;
---
<div class="scroll-sentinel" id="scrollSentinel" aria-hidden="true"></div>
<header class="header" id="header">
  <div class="header__in">
    <a href={home ? '#top' : localePath(lang, '/')} class="brand">
      <BrandMark />
      <span class="brand__name"><span class="brand__series">{site.brandSeries}<span class="visually-hidden">:</span></span> <span class="brand__title">{site.brand}</span></span>
    </a>
    <nav class="nav" aria-label="Main">
      {site.nav.map((l) => <a href={anchor(l.href, home, lang)}>{l.label}</a>)}
    </nav>
    <div class="header__actions">
      <LangSwitch class="header__lang" />
      <a href={anchor('#get', home, lang)} class="btn btn--gold btn--sm" data-track="cta_click" data-track-location="header">{site.header.cta}</a>
      <button class="burger" id="burger" type="button" aria-controls="menu" aria-expanded="false"
        aria-label={site.header.openMenu} data-open-label={site.header.openMenu} data-close-label={site.header.closeMenu}><span></span></button>
    </div>
  </div>
</header>

<style>
  .scroll-sentinel { position: absolute; top: 24px; left: 0; width: 1px; height: 1px; pointer-events: none }
  .header { position: fixed; inset: 0 0 auto 0; z-index: 50; transition: background .4s var(--ease), border-color .4s var(--ease), backdrop-filter .4s; border-bottom: 1px solid transparent }
  .header.is-scrolled { background: rgba(10, 8, 6, .82); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-color: var(--line) }
  /* keep the header (and its close button) above the open mobile menu */
  :global(body.menu-open) .header { z-index: 70; background: transparent; border-color: transparent; backdrop-filter: none; -webkit-backdrop-filter: none }
  .header__in { display: flex; align-items: center; gap: 40px; height: 76px; padding: 0 var(--gutter); max-width: 1440px; margin: 0 auto }
  .brand { display: flex; align-items: center; gap: 12px; font-family: var(--display); font-weight: 600; font-size: 22px; letter-spacing: .02em; white-space: nowrap }
  .brand :global(.brand__mark) { width: 26px; height: 26px; color: var(--gold) }
  .nav { display: flex; gap: 32px; margin: 0 auto }
  .nav a { white-space: nowrap; font-size: 14px; letter-spacing: .04em; color: var(--ink-2); opacity: .8; transition: opacity .2s, color .2s }
  .nav a:hover { opacity: 1; color: var(--gold-hi) }
  .header__actions { display: flex; align-items: center; gap: 12px }
  .burger { display: none; width: 40px; height: 40px; align-items: center; justify-content: center }
  .burger span { position: relative; width: 20px; height: 1.5px; background: var(--ink); transition: background .2s }
  .burger span::before, .burger span::after { content: ""; position: absolute; left: 0; width: 20px; height: 1.5px; background: var(--ink); transition: transform .3s var(--ease) }
  .burger span::before { top: -6px }
  .burger span::after { top: 6px }
  .burger[aria-expanded="true"] span { background: transparent }
  .burger[aria-expanded="true"] span::before { transform: translateY(6px) rotate(45deg) }
  .burger[aria-expanded="true"] span::after { transform: translateY(-6px) rotate(-45deg) }

  /* the full brand name needs the room: nav steps aside below 1080px */
  @media (max-width: 1080px) {
    .nav { display: none }
    .header__actions { margin-left: auto }
  }
  @media (max-width: 760px) {
    .header__in { height: 64px; gap: 16px }
    .brand { font-size: 19px }
    .header__actions .btn, .header__actions :global(.header__lang) { display: none } /* both live in the mobile menu */
    .burger { display: inline-flex }
  }
</style>

<script>
  // Solid header once the page is scrolled past 24px. Watching a sentinel
  // avoids reading scrollY (a forced layout) on load and on every scroll.
  const header = document.getElementById('header')!;
  const sentinel = document.getElementById('scrollSentinel')!;
  new IntersectionObserver(([e]) => header.classList.toggle('is-scrolled', !e.isIntersecting)).observe(sentinel);
</script>
