---
import { locales, localeCodes, getLang, switchPath, useT } from '../i18n';

// Language picker.
// - "menu" (header): globe + current code, opens a small list of languages.
// - "list" (mobile menu): labelled row of languages, current one checked.
interface Props { variant?: 'menu' | 'list'; class?: string }
const { variant = 'menu', class: cls } = Astro.props;
const lang = getLang(Astro);
const site = useT(Astro);
const current = locales[lang].locale;
const items = localeCodes.map((code) => ({
  ...locales[code].locale,
  href: switchPath(Astro.url.pathname, lang, code),
  current: code === lang,
}));
const id = `lang-${variant}`;
---
{items.length > 1 && variant === 'menu' && (
  <div class:list={['lang', cls]} data-lang-menu>
    <button type="button" class="lang__btn" aria-expanded="false" aria-controls={id} aria-haspopup="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>
      <span aria-hidden="true">{current.short}</span>
      <span class="visually-hidden">{site.header.languageLabel}: {current.name}</span>
      <svg class="lang__chev" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M1 1.5l5 5 5-5"/></svg>
    </button>
    <ul class="lang__list" id={id} hidden>
      {items.map((l) => (
        <li>
          <a href={l.href} hreflang={l.htmlLang} lang={l.htmlLang} aria-current={l.current ? 'true' : undefined}>
            <span>{l.name}</span>
            {l.current && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

{items.length > 1 && variant === 'list' && (
  <nav class:list={['lang-row', cls]} aria-label={site.header.languageLabel}>
    <span class="lang-row__label" aria-hidden="true">{site.header.languageLabel}</span>
    <ul>
      {items.map((l) => (
        <li>
          <a href={l.href} hreflang={l.htmlLang} lang={l.htmlLang} aria-current={l.current ? 'true' : undefined}>{l.name}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  /* ---------- header dropdown ---------- */
  .lang { position: relative }
  .lang__btn { display: inline-flex; align-items: center; gap: 7px; height: 40px; padding: 0 10px; border-radius: 999px; font-size: 14px; font-weight: 500; letter-spacing: .04em; color: var(--ink-2); transition: color .2s, background .2s }
  .lang__btn:hover, .lang__btn[aria-expanded="true"] { color: var(--gold-hi); background: rgba(243, 235, 221, .05) }
  .lang__btn svg { width: 16px; height: 16px; opacity: .85 }
  .lang__btn .lang__chev { width: 10px; height: 7px; transition: transform .2s var(--ease) }
  .lang__btn[aria-expanded="true"] .lang__chev { transform: rotate(180deg) }
  .lang__list { position: absolute; right: 0; top: calc(100% + 8px); z-index: 80; min-width: 184px; list-style: none; padding: 6px; border-radius: 14px;
    background: linear-gradient(180deg, #1A140E, #110D09); box-shadow: 0 0 0 1px var(--line) inset, 0 24px 60px -16px rgba(0, 0, 0, .9); animation: lang-in .18s var(--ease) }
  .lang__list a { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 12px; border-radius: 9px; font-size: 15px; color: var(--ink-2) }
  .lang__list a:hover, .lang__list a:focus-visible { background: rgba(243, 235, 221, .06); color: var(--ink) }
  .lang__list a[aria-current] { color: var(--gold-hi) }
  .lang__list svg { width: 16px; height: 16px; color: var(--gold) }
  @keyframes lang-in { from { opacity: 0; transform: translateY(-4px) } }

  /* ---------- mobile menu row ---------- */
  .lang-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 0 4px }
  .lang-row__label { font-size: 12px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--muted-solid) }
  .lang-row ul { display: flex; gap: 6px; list-style: none }
  .lang-row a { display: inline-flex; align-items: center; height: 38px; padding: 0 14px; border-radius: 999px; font-size: 15px; font-weight: 500; color: var(--ink-2); box-shadow: 0 0 0 1px var(--line) inset }
  .lang-row a[aria-current] { color: #1E1408; background: linear-gradient(180deg, var(--gold-hi), var(--gold)); box-shadow: none }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-lang-menu]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('.lang__btn')!;
    const list = root.querySelector<HTMLElement>('.lang__list')!;
    const links = () => [...list.querySelectorAll<HTMLAnchorElement>('a')];

    const set = (open: boolean, focusBtn = false) => {
      list.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      if (open) (links().find((a) => a.hasAttribute('aria-current')) ?? links()[0])?.focus();
      else if (focusBtn) btn.focus();
    };

    btn.addEventListener('click', () => set(Boolean(list.hidden)));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !list.hidden) { e.stopPropagation(); set(false, true); }
      if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && !list.hidden) {
        e.preventDefault();
        const all = links(); const i = all.indexOf(document.activeElement as HTMLAnchorElement);
        all[(i + (e.key === 'ArrowDown' ? 1 : -1) + all.length) % all.length]?.focus();
      }
    });
    // close when clicking elsewhere or tabbing out
    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) set(false); });
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node)) set(false); });
  });
</script>
