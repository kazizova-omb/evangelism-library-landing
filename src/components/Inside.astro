---
import Icon from './Icon.astro';
import SlotImage from './SlotImage.astro';
import { useT } from '../i18n';
import { config } from '../config';
import { rich } from '../lib/rich';
import { slot } from '../lib/slots';

const site = useT(Astro);

const s = site.inside;
const g = s.gallery;
const img = {
  slide: slot('gallery-slide'),
  flyer: slot('gallery-flyer'),
  art: slot('gallery-art'),
  video: slot('gallery-video'),
  social: slot('gallery-social'),
};
const wide = { sizes: '(max-width: 760px) calc(100vw - 40px), (max-width: 1240px) 66vw, 800px', widths: [480, 800, 1200, 1600] };
const narrow = { sizes: '(max-width: 760px) 50vw, (max-width: 1240px) 33vw, 400px', widths: [320, 480, 800] };
---
<section class="section glow-r" id="inside" aria-labelledby="inside-title">
  <div class="wrap">
    <div class="inside-head reveal">
      <div>
        <p class="eyebrow">{s.eyebrow}</p>
        <h2 class="h2" id="inside-title" set:html={rich(s.title)} />
      </div>
      <p class="sub">{s.sub}</p>
    </div>
    <dl class="stats reveal">
      {s.stats.map((st) => (
        <div class="stat"><dt>{st.label}</dt><dd>{st.value}</dd></div>
      ))}
    </dl>
    <div class="stats-note reveal">
      <span>{s.note}</span>
      {config.showPlaceholderTags && <span class="tag">{site.placeholderTags.stats}</span>}
    </div>
    <div class="gallery reveal">
      <figure class="tile t-slide">
        {img.slide ? <SlotImage src={img.slide} alt={g.slide.alt} {...wide} /> : (
          <Fragment>
            <div class="tile__bg"></div>
            <div class="slide-copy" aria-hidden="true"><small>{g.slide.kicker}</small><strong set:html={rich(g.slide.title)} /></div>
          </Fragment>
        )}
        <figcaption>{g.slide.caption}</figcaption>
      </figure>
      <figure class="tile t-flyer">
        {img.flyer ? <SlotImage src={img.flyer} alt={g.flyer.alt} {...narrow} /> : (
          <Fragment>
            <div class="tile__bg"></div>
            <div class="flyer" aria-hidden="true"><small>{g.flyer.kicker}</small><strong>{g.flyer.title}</strong><i></i><i></i></div>
          </Fragment>
        )}
        <figcaption>{g.flyer.caption}</figcaption>
      </figure>
      <figure class="tile t-art">
        {img.art ? <SlotImage src={img.art} alt={g.art.alt} {...narrow} /> : <div class="tile__bg"></div>}
        <figcaption>{g.art.caption}</figcaption>
      </figure>
      <figure class="tile t-video">
        {img.video ? <SlotImage src={img.video} alt={g.video.alt} {...narrow} /> : <div class="tile__bg"></div>}
        <span class="mini-play" aria-hidden="true"><Icon name="play" /></span>
        <figcaption>{g.video.caption}</figcaption>
      </figure>
      <figure class="tile t-social">
        {img.social ? <SlotImage src={img.social} alt={g.social.alt} {...narrow} /> : (
          <Fragment>
            <div class="tile__bg"></div>
            <div class="social" aria-hidden="true"><strong>{g.social.title}</strong></div>
          </Fragment>
        )}
        <figcaption>{g.social.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  /* heading left, intro right: fills the row instead of leaving it half empty */
  .inside-head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px 64px; align-items: end; margin-bottom: 56px }
  .inside-head .h2 { margin-bottom: 0; text-wrap: balance }
  .inside-head .sub { max-width: 420px; padding-bottom: 4px }

  /* stats: open row on the text grid, hairline dividers, lining figures */
  .stats { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line) }
  .stat { display: flex; flex-direction: column; gap: 12px; padding: 32px 24px 30px; border-left: 1px solid var(--line) }
  .stat:first-child { border-left: 0; padding-left: 0 }
  .stat dd { font-family: var(--display); font-weight: 600; font-size: clamp(44px, 4.6vw, 66px); line-height: .9; letter-spacing: -.01em;
    font-variant-numeric: lining-nums proportional-nums; font-feature-settings: "lnum" 1, "pnum" 1;
    background: linear-gradient(180deg, var(--gold-hi), var(--gold) 70%); -webkit-background-clip: text; background-clip: text; color: transparent }
  .stat dt { order: 2; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--muted-solid) }
  .stats-note { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin: 16px 0 48px; font-size: 14px; color: var(--muted-solid) }

  /* tablet: 3 + 2 on a 6-column grid */
  @media (max-width: 1020px) {
    .inside-head { grid-template-columns: 1fr; margin-bottom: 44px }
    .inside-head .sub { max-width: 560px; padding-bottom: 0 }
    .stats { grid-template-columns: repeat(6, minmax(0, 1fr)) }
    .stat { grid-column: span 2 }
    .stat:nth-child(n+4) { grid-column: span 3; border-top: 1px solid var(--line) }
    .stat:nth-child(4) { border-left: 0; padding-left: 0 }
  }

  .gallery { display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-rows: 190px; gap: 16px; grid-auto-flow: dense }
  .tile { position: relative; margin: 0; border-radius: 10px; overflow: hidden; box-shadow: 0 0 0 1px var(--line); isolation: isolate; background: #110C08 }
  .tile__bg, .tile :global(.slot-img) { position: absolute; inset: 0; transition: transform 1.2s var(--ease) }
  .tile:hover .tile__bg, .tile:hover :global(.slot-img) { transform: scale(1.04) }
  .tile::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 58%, rgba(0, 0, 0, .7)); z-index: 1; pointer-events: none }
  .tile figcaption { position: absolute; left: 18px; bottom: 14px; z-index: 2; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2) }
  .t-slide { grid-column: span 4; grid-row: span 2 }
  .t-flyer { grid-column: span 2; grid-row: span 2 }
  .t-art, .t-video, .t-social { grid-column: span 2 }

  .t-slide .tile__bg { background: radial-gradient(55% 85% at 76% 72%, rgba(255, 214, 145, .9), rgba(224, 150, 70, .45) 22%, rgba(120, 60, 20, .15) 45%, transparent 65%), linear-gradient(180deg, #09070A, #1C1109 70%, #0B0807) }
  .t-slide .tile__bg::before, .t-slide .tile__bg::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0 }
  .t-slide .tile__bg::before { height: 40%; background: linear-gradient(180deg, #3A2412, #140D07); clip-path: polygon(0 55%, 12% 38%, 26% 50%, 42% 26%, 58% 44%, 72% 18%, 86% 36%, 100% 22%, 100% 100%, 0 100%) }
  .t-slide .tile__bg::after { height: 26%; background: #0B0807; clip-path: polygon(0 50%, 20% 30%, 38% 55%, 60% 35%, 80% 60%, 100% 40%, 100% 100%, 0 100%) }
  .slide-copy { position: absolute; left: 7%; top: 44%; transform: translateY(-50%); z-index: 2; max-width: 52% }
  .slide-copy small { font-size: 11px; font-weight: 600; letter-spacing: .26em; text-transform: uppercase; color: var(--gold) }
  .slide-copy strong { display: block; margin-top: 12px; font-family: var(--display); font-weight: 600; font-size: clamp(30px, 3.6vw, 54px); line-height: .98 }
  .slide-copy strong :global(em) { font-weight: 500; color: var(--gold-hi) }

  .t-flyer .tile__bg { background: radial-gradient(70% 60% at 50% 20%, rgba(201, 119, 46, .25), transparent 70%), linear-gradient(180deg, #1A100A, #0B0807) }
  .flyer { position: absolute; top: 22px; bottom: 48px; left: 50%; transform: translateX(-50%); aspect-ratio: 8.5/11; z-index: 2; border-radius: 4px; overflow: hidden; box-shadow: 0 24px 50px -10px rgba(0, 0, 0, .8), 0 0 0 1px rgba(243, 235, 221, .1);
    background: radial-gradient(90% 45% at 50% 34%, rgba(255, 228, 170, .95), rgba(232, 160, 80, .55) 30%, rgba(120, 60, 20, .2) 60%, transparent 80%), linear-gradient(180deg, #140D08, #0A0806); display: flex; flex-direction: column; justify-content: flex-end; padding: 9% 10% }
  .flyer small { font-size: 9px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--gold) }
  .flyer strong { font-family: var(--display); font-weight: 600; font-size: clamp(20px, 1.9vw, 28px); line-height: 1; margin: 6px 0 10px }
  .flyer i { display: block; height: 4px; border-radius: 2px; background: rgba(243, 235, 221, .25); margin-top: 5px }
  .flyer i:last-child { width: 60% }

  .t-art .tile__bg { background: radial-gradient(35% 55% at 30% 42%, rgba(255, 232, 185, .9), rgba(214, 128, 52, .4) 35%, transparent 70%), radial-gradient(1px 1px at 70% 20%, #fff9 50%, transparent 51%), radial-gradient(1px 1px at 84% 34%, #fff7 50%, transparent 51%), radial-gradient(1.2px 1.2px at 62% 12%, #fff8 50%, transparent 51%), linear-gradient(160deg, #2A160A, #0B0807 70%) }
  .t-art .tile__bg::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 45%; background: #0C0806; clip-path: polygon(0 40%, 18% 20%, 34% 45%, 55% 10%, 74% 42%, 100% 18%, 100% 100%, 0 100%) }

  .t-video .tile__bg { background: linear-gradient(90deg, transparent 38%, rgba(255, 220, 160, .3) 50%, transparent 62%), radial-gradient(60% 60% at 50% 100%, rgba(224, 154, 72, .45), transparent 70%), #0C0907 }
  .mini-play { position: absolute; left: 50%; top: 44%; transform: translate(-50%, -50%); z-index: 2; width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; background: rgba(243, 235, 221, .14); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); box-shadow: 0 0 0 1px rgba(243, 235, 221, .3) inset }
  .mini-play :global(svg) { width: 16px; height: 16px; margin-left: 2px; color: var(--ink) }

  .t-social .tile__bg { background: radial-gradient(80% 80% at 50% 50%, rgba(201, 119, 46, .22), transparent 70%), #140D08 }
  .social { position: absolute; top: 18px; bottom: 44px; left: 50%; transform: translateX(-50%); aspect-ratio: 1; z-index: 2; border-radius: 6px; display: grid; place-items: center; text-align: center; padding: 10%;
    background: radial-gradient(70% 70% at 50% 110%, rgba(246, 204, 130, .75), rgba(201, 119, 46, .3) 40%, transparent 75%), #0E0906; box-shadow: 0 20px 40px -12px rgba(0, 0, 0, .8), 0 0 0 1px rgba(243, 235, 221, .1) }
  .social strong { font-family: var(--display); font-style: italic; font-weight: 500; font-size: clamp(18px, 1.6vw, 24px); line-height: 1.05; color: var(--gold-hi) }

  @media (max-width: 760px) {
    .inside-head { margin-bottom: 36px }
    .stats { grid-template-columns: 1fr 1fr }
    .stat, .stat:nth-child(n+4) { grid-column: auto; padding: 24px 0 22px 20px; border-left: 1px solid var(--line); border-top: 0 }
    .stat:nth-child(odd) { border-left: 0; padding-left: 0 }
    .stat:nth-child(n+3) { border-top: 1px solid var(--line) }
    .stat:last-child { grid-column: span 2 }
    .stat dd { font-size: 44px }
    .stats-note { flex-direction: column; align-items: flex-start; margin-bottom: 32px }
    .gallery { grid-template-columns: 1fr 1fr; grid-auto-rows: 150px; gap: 12px }
    .t-slide { grid-column: span 2; grid-row: span 2 }
    .t-flyer { grid-column: span 1; grid-row: span 2 }
    .t-art, .t-social { grid-column: span 1 }
    .t-video { grid-column: span 2 }
    .slide-copy { max-width: 70% }
    .tile figcaption { left: 12px; bottom: 10px; font-size: 10.5px }
    .flyer { top: 16px; bottom: auto; width: 78% }
    .social { top: 12px; bottom: 36px }
  }
</style>
