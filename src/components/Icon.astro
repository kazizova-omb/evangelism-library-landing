---
// Inline SVG icons from the prototype. Decorative: always aria-hidden.
export type IconName = 'mark' | 'play' | 'download' | 'check' | 'close' | 'success' | 'mail' | 'image' | 'book' | 'screen' | 'pen' | 'doc' | 'globe';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: cls } = Astro.props;
const line = { fill: 'none', stroke: 'currentColor', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---
{name === 'mark' && (
  <svg class={cls} viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 2v28M2 16h28" stroke="currentColor" stroke-width="1.4"/><path d="M16 6l2.6 7.4L26 16l-7.4 2.6L16 26l-2.6-7.4L6 16l7.4-2.6z" fill="currentColor"/></svg>
)}
{name === 'play' && (
  <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5z"/></svg>
)}
{name === 'download' && (
  <svg class={cls} viewBox="0 0 24 24" {...line} stroke-width="1.7" aria-hidden="true"><path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19h14"/></svg>
)}
{name === 'check' && (
  <svg class={cls} viewBox="0 0 24 24" {...line} stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.8"/></svg>
)}
{name === 'close' && (
  <svg class={cls} viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13"/></svg>
)}
{name === 'success' && (
  <svg class={cls} viewBox="0 0 24 24" {...line} stroke-width="2.2" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
)}
{name === 'mail' && (
  <svg class={cls} viewBox="0 0 24 24" {...line} stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg>
)}
{name === 'image' && (
  <svg class={cls} viewBox="0 0 24 24" {...line} stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 15l5-5 4 4 3-3 6 6"/><circle cx="16" cy="9" r="1.5"/></svg>
)}
{name === 'book' && (
  <svg class={cls} viewBox="0 0 24 24" {...line} stroke-width="1.6" aria-hidden="true"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5z"/><path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5z"/><path d="M15.5 10l1.3 1.3 2.2-2.6"/></svg>
)}
{name === 'screen' && (
  <svg class={cls} viewBox="0 0 24 24" {...line} stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20h8M12 16v4M10 8.5v3l3-1.5z"/></svg>
)}
{name === 'pen' && (
  <svg class={cls} viewBox="0 0 24 24" {...line} stroke-width="1.6" aria-hidden="true"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z"/><path d="M13.5 6.5l4 4"/></svg>
)}
{name === 'doc' && (
  <svg class={cls} viewBox="0 0 24 24" {...line} stroke-width="1.6" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
)}
{name === 'globe' && (
  <svg class={cls} viewBox="0 0 24 24" {...line} stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>
)}
