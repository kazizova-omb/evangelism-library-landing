---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Optimized image for a placeholder slot (AVIF + WebP, intrinsic width/height).
// Wrapped in .slot-img, which fills the positioned parent.
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths: number[];
  /** above the fold: eager + high priority */
  priority?: boolean;
}
const { src, alt, sizes, widths, priority = false } = Astro.props;
---
<div class="slot-img">
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths.filter((w) => w <= src.width).concat(widths.some((w) => w > src.width) ? [src.width] : [])}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</div>
