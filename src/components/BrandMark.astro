---
import Icon from './Icon.astro';
import { logo } from '../lib/slots';

const h = 32;

// Brand symbol: the uploaded logo if there is one, otherwise the star mark.
---
{logo ? <img class="brand__logo" src={logo.url} alt="" width={Math.round(h * logo.ratio)} height={h} /> : <Icon name="mark" class="brand__mark" />}

<style>
  .brand__logo { height: 32px; width: auto; max-width: 64px; object-fit: contain }
  @media (max-width: 760px) { .brand__logo { height: 28px } }
</style>
