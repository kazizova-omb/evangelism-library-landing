---
// The illustrated book and the audiobook in one block. The book is a print PDF (cover, then two-page
// spreads), so the landing shows a few of its pages in a short looping page-turn animation. The audio is a short sample from chapter 2;
// the full book and audiobook download in the portal (registration first, like the presentations).
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import { useT, getLang, localePath } from '../i18n';
import { rich } from '../lib/rich';
import cover from '../assets/book/cover.jpg';
import s1 from '../assets/book/spread-1.jpg';
import s2 from '../assets/book/spread-2.jpg';
import s3 from '../assets/book/spread-3.jpg';
import s4 from '../assets/book/spread-4.jpg';

const site = useT(Astro);
const b = site.book;
const portal = localePath(getLang(Astro), '/downloads');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sample = `${base}/media/audio/daniel-2-sample.mp3`;
// sheet i: front = right page of the cover or spread i, back = left page of spread i+1; the last spread's
// right page lies under them all
const spreads = [s1, s2, s3, s4];
const leaves = spreads.map((back, i) => ({ front: i === 0 ? cover : spreads[i - 1], back }));
const last = spreads[spreads.length - 1];
const SW = [800, 1200, 1600];
const SS = '(max-width: 1020px) 90vw, 620px';
---
<section class="section" id="book" aria-labelledby="book-title">
  <div class="wrap">
    <div class="bk reveal">
      <div class="bk__viewer">
        <!-- a short looping animation: the closed book opens and its pages turn, then it closes and starts
             again. Each leaf is one sheet: its front is the right page of one spread (or the cover), its back
             is the left page of the next spread, both cut from the spread pictures with CSS -->
        <div class="bk__stage" data-book role="img" aria-label={b.viewerLabel}>
          <div class="fb" data-fb>
            <div class="fb__base"><div class="fb__face is-r"><Image src={last} alt="" widths={SW} sizes={SS} format="webp" loading="lazy" decoding="async" /></div></div>
            {leaves.map((leaf, i) => (
              <div class="fb__leaf" style={`z-index:${leaves.length - i}`}>
                <div class:list={['fb__face fb__front', i === 0 ? 'is-cover' : 'is-r']}>
                  {i === 0
                    ? <Image src={cover} alt="" widths={[400, 640, 900]} sizes="(max-width: 1020px) 45vw, 320px" format="webp" loading="eager" decoding="async" />
                    : <Image src={leaf.front} alt="" widths={SW} sizes={SS} format="webp" loading="lazy" decoding="async" />}
                </div>
                <div class="fb__face fb__back is-l"><Image src={leaf.back} alt="" widths={SW} sizes={SS} format="webp" loading="lazy" decoding="async" /></div>
              </div>
            ))}
          </div>
        </div>
        <div class="bk__nav">
          <button type="button" class="bk__toggle" aria-label={b.stopAnim} data-label-stop={b.stopAnim} data-label-play={b.playAnim}>
            <span class="i-pause" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg></span>
            <span class="i-play" aria-hidden="true"><Icon name="play" /></span>
          </button>
          <span class="bk__note">{b.sampleNote}</span>
        </div>
      </div>

      <div class="bk__text">
        <p class="eyebrow">{b.eyebrow}</p>
        <h2 class="h2" id="book-title" set:html={rich(b.title)} />
        <p class="sub">{b.sub}</p>

        <div class="player" data-player>
          <audio preload="none" src={sample}></audio>
          <button type="button" class="player__btn" aria-label={b.play} data-label-play={b.play} data-label-pause={b.pause} data-track="audio_play" data-track-location="book">
            <span class="i-play"><Icon name="play" /></span>
            <span class="i-pause" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg></span>
          </button>
          <div class="player__body">
            <p class="player__title">{b.trackTitle}<span>{b.trackTag}</span></p>
            <input class="player__bar" type="range" min="0" max="1000" value="0" step="1" aria-label={b.seek} />
            <p class="player__time"><span data-cur>0:00</span><span data-dur>{b.trackLength}</span></p>
          </div>
        </div>

        <ul class="bk__list" role="list">
          {b.includes.map((item) => <li><Icon name="check" />{item}</li>)}
        </ul>
        <a href="#access" class="btn btn--gold bk__get" data-portal={`${portal}#materials`} data-download-label={b.download}
          data-track="cta_click" data-track-location="book"><span>{b.cta}</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .bk .h2 { text-wrap: balance }
  .bk { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center }

  /* page-turn animation. The stage is a dark field in the cover's own blues; the book (one spread,
     5100x3300) sits in it, shifted left by a quarter while closed so the cover is centred */
  .bk__stage { --turn: 1.1s; --ease-turn: cubic-bezier(.5, .05, .25, 1);
    position: relative; display: grid; place-items: center; width: 100%; aspect-ratio: 16 / 11; border-radius: 10px; overflow: hidden;
    background: radial-gradient(70% 80% at 50% 45%, #2F4C8A, #14204A 70%, #0D1433) }
  .fb { position: relative; width: 88%; aspect-ratio: 5100 / 3300; perspective: 2600px; transform: translateX(-25%); transition: transform var(--turn) var(--ease-turn) }
  .fb.is-open { transform: none }
  .fb__base, .fb__leaf { position: absolute; top: 0; left: 50%; width: 50%; height: 100% }
  .fb__leaf { transform-origin: left center; transform-style: preserve-3d; transition: transform var(--turn) var(--ease-turn) }
  .fb__leaf.is-flipped { transform: rotateY(-180deg) }
  .fb__face { position: absolute; inset: 0; overflow: hidden; background: #fff; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    border-radius: 0 5px 5px 0; box-shadow: 0 24px 40px -22px rgba(0, 0, 0, .75) }
  .fb__back { transform: rotateY(180deg); border-radius: 5px 0 0 5px }
  /* a spread picture is twice the page width: the right page shows its right half, the left page its left half */
  .fb__face :global(img) { position: absolute; top: 0; left: -100%; width: 200%; max-width: none; height: 100%; object-fit: cover }
  .fb__face.is-l :global(img) { left: 0 }
  .fb__face.is-cover :global(img) { left: 0; width: 100% }
  /* spine shade on the inner edge of every page, and a light that sweeps over a sheet while it turns */
  .fb__face::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(90deg, rgba(0, 0, 0, .28), rgba(0, 0, 0, .08) 4%, transparent 10%) }
  .fb__back::after { background: linear-gradient(270deg, rgba(0, 0, 0, .28), rgba(0, 0, 0, .08) 4%, transparent 10%) }
  .fb__face.is-cover::after { background: linear-gradient(90deg, rgba(0, 0, 0, .35), rgba(255, 255, 255, .18) 1.6%, rgba(0, 0, 0, .12) 3.2%, transparent 7%) }
  .fb__face::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: 0; background: linear-gradient(90deg, rgba(0, 0, 0, .35), rgba(255, 255, 255, .12)) }
  .fb__leaf.is-turning .fb__face::before { animation: fb-shade var(--turn) var(--ease-turn) }
  @keyframes fb-shade { 50% { opacity: 1 } }

  .bk__nav { display: flex; align-items: center; gap: 12px; margin-top: 14px }
  .bk__toggle { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; color: var(--navy, #1F2160); border: 1px solid rgba(31, 33, 96, .2); background: #fff; transition: background .2s }
  .bk__toggle:hover { background: var(--paper-2, #ECE9E1) }
  .bk__toggle :global(svg) { width: 16px; height: 16px }
  .bk__toggle .i-play :global(svg) { margin-left: 2px }
  .bk__toggle .i-play, .bk__toggle.is-paused .i-pause { display: none }
  .bk__toggle.is-paused .i-play { display: block }
  .bk__note { font-size: 13px; color: var(--muted-solid) }

  /* audio sample */
  .player { display: flex; align-items: center; gap: 16px; margin: 28px 0 24px; padding: 16px 20px 14px 16px; border-radius: 14px; color: #fff; background: var(--indigo, #2A2C7C) }
  .player__btn { flex: none; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; color: var(--indigo, #2A2C7C); background: #fff; transition: transform .2s var(--ease) }
  .player__btn:hover { transform: scale(1.06) }
  .player__btn :global(svg) { width: 22px; height: 22px }
  .player__btn .i-play :global(svg) { margin-left: 3px }
  .player__btn .i-pause { display: none }
  .player.is-playing .i-play { display: none }
  .player.is-playing .i-pause { display: block }
  .player__body { flex: 1; min-width: 0 }
  .player__title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-weight: 600; font-size: 16px; margin-bottom: 8px }
  .player__title span { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--cyan-light, #7FE0EC) }
  .player__bar { --p: 0%; display: block; width: 100%; height: 18px; margin: 0; background: transparent; appearance: none; -webkit-appearance: none; cursor: pointer }
  .player__bar::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--cyan-light, #7FE0EC) var(--p), rgba(255, 255, 255, .25) var(--p)) }
  .player__bar::-moz-range-track { height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--cyan-light, #7FE0EC) var(--p), rgba(255, 255, 255, .25) var(--p)) }
  .player__bar::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; margin-top: -5px; border-radius: 50%; border: 0; background: #fff }
  .player__bar::-moz-range-thumb { width: 14px; height: 14px; border-radius: 50%; border: 0; background: #fff }
  .player__time { display: flex; justify-content: space-between; margin-top: 4px; font-size: 12px; font-variant-numeric: tabular-nums; color: rgba(255, 255, 255, .7) }

  .bk__list { list-style: none; display: grid; gap: 12px; margin: 0 0 28px }
  .bk__list li { display: flex; gap: 12px; align-items: flex-start; color: var(--ink-2) }
  .bk__list :global(svg) { flex: none; width: 20px; height: 20px; margin-top: 2px; color: var(--cyan-text, var(--gold)) }

  @media (max-width: 1020px) {
    .bk { grid-template-columns: 1fr }
    .bk__text { order: -1 }
  }
  @media (max-width: 560px) {
    .bk__note { display: none }
    .bk__nav { justify-content: center }
    .player { padding: 14px; gap: 12px }
    .player__btn { width: 48px; height: 48px }
    .bk__get { width: 100% }
  }
</style>

<script>
  import { me } from '../scripts/api';

  // page-turn animation: closed cover, then the pages turn one by one, then the book closes and loops.
  // It runs only while on screen, stops with the button, and stays on the first spread for reduced motion.
  document.querySelectorAll<HTMLElement>('[data-book]').forEach((stage) => {
    const book = stage.querySelector<HTMLElement>('[data-fb]')!;
    const leaves = [...book.querySelectorAll<HTMLElement>('.fb__leaf')];
    const toggle = stage.parentElement!.querySelector<HTMLButtonElement>('.bk__toggle')!;
    const n = leaves.length;
    const TURN = 1100;
    const GAP = 140; // between sheets when the book closes
    let flipped = 0;
    let timer = 0;
    let visible = false;
    let paused = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // a turning sheet goes on top; once it lands, the last one turned lies on top of the left stack and the
    // next one to turn lies on top of the right stack
    const turn = (i: number, fwd: boolean) => {
      const l = leaves[i];
      l.style.zIndex = String(fwd ? 50 : 50 + n - i);
      l.classList.add('is-turning');
      l.classList.toggle('is-flipped', fwd);
      setTimeout(() => { l.classList.remove('is-turning'); l.style.zIndex = String(fwd ? i + 1 : n - i); }, TURN);
    };
    const schedule = (ms: number) => {
      clearTimeout(timer);
      if (!paused && visible && !document.hidden) timer = window.setTimeout(step, ms);
    };
    function step() {
      if (flipped < n) {
        book.classList.add('is-open');
        turn(flipped++, true);
        schedule(TURN + (flipped === n ? 2600 : 1500));
      } else {
        for (let k = n - 1; k >= 0; k--) setTimeout(() => turn(k, false), (n - 1 - k) * GAP);
        setTimeout(() => book.classList.remove('is-open'), (n - 1) * GAP);
        flipped = 0;
        schedule(TURN + n * GAP + 1600);
      }
    }

    // reduced motion: show the first spread, still; the button can start it
    if (paused) {
      leaves[0].style.transition = 'none'; book.style.transition = 'none';
      leaves[0].classList.add('is-flipped'); leaves[0].style.zIndex = '1'; book.classList.add('is-open'); flipped = 1;
      requestAnimationFrame(() => requestAnimationFrame(() => { leaves[0].style.transition = ''; book.style.transition = ''; }));
    }
    const label = () => {
      toggle.classList.toggle('is-paused', paused);
      toggle.setAttribute('aria-label', (paused ? toggle.dataset.labelPlay : toggle.dataset.labelStop)!);
    };
    label();
    toggle.addEventListener('click', () => { paused = !paused; label(); if (paused) clearTimeout(timer); else schedule(300); });

    // load the inner pages once the block is near, and only run while it is on screen
    new IntersectionObserver((entries, io) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      stage.querySelectorAll('img').forEach((img) => { img.loading = 'eager'; });
      io.disconnect();
    }, { rootMargin: '400px 0px' }).observe(stage);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) schedule(flipped === 0 ? 1200 : 800); else clearTimeout(timer);
    }, { threshold: 0.35 }).observe(stage);
    document.addEventListener('visibilitychange', () => { if (document.hidden) clearTimeout(timer); else schedule(800); });
  });

  // audio sample player
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((p) => {
    const audio = p.querySelector('audio')!;
    const btn = p.querySelector<HTMLButtonElement>('.player__btn')!;
    const bar = p.querySelector<HTMLInputElement>('.player__bar')!;
    const cur = p.querySelector<HTMLElement>('[data-cur]')!;
    const dur = p.querySelector<HTMLElement>('[data-dur]')!;
    const paint = () => {
      const r = audio.duration ? audio.currentTime / audio.duration : 0;
      bar.value = String(Math.round(r * 1000)); bar.style.setProperty('--p', `${r * 100}%`);
      cur.textContent = fmt(audio.currentTime);
    };
    btn.addEventListener('click', () => { if (audio.paused) audio.play(); else audio.pause(); });
    audio.addEventListener('play', () => { p.classList.add('is-playing'); btn.setAttribute('aria-label', btn.dataset.labelPause!); });
    audio.addEventListener('pause', () => { p.classList.remove('is-playing'); btn.setAttribute('aria-label', btn.dataset.labelPlay!); });
    audio.addEventListener('loadedmetadata', () => { dur.textContent = fmt(audio.duration); });
    audio.addEventListener('timeupdate', paint);
    audio.addEventListener('ended', () => { audio.currentTime = 0; paint(); });
    bar.addEventListener('input', () => {
      if (audio.readyState === 0) audio.load();
      const seek = () => { audio.currentTime = (Number(bar.value) / 1000) * audio.duration; paint(); };
      if (audio.duration) seek(); else audio.addEventListener('loadedmetadata', seek, { once: true });
    });
  });

  // the download button leads to registration, or straight to the portal once signed in
  me().then((u) => {
    if (!u) return;
    document.querySelectorAll<HTMLAnchorElement>('.bk__get').forEach((a) => {
      a.href = a.dataset.portal ?? a.href;
      a.querySelector('span')!.textContent = a.dataset.downloadLabel ?? '';
    });
  }).catch(() => {});
</script>
